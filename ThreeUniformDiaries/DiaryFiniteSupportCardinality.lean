import ThreeUniformDiaries.DiaryFiniteLeafMeetSupport

/-!
# Track C: uniform size bound for finite diary support shapes

For m selected genuine leaves the exact finite support consists of:
* three markers and the selected leaves;
* singleton meets of distinct ordered selected leaf pairs;
* full meets of TWO ordered leaf pairs.

A crude but uniform polynomial bound is sufficient for the upper
bound's finite source-shape enumeration. Its proof is independent of
any diary axioms, generic extension, source embeddings, or Ramsey.

This does NOT enumerate the *sharp* diary types and does not prove
that each finite support inclusion is auxiliary-type-respecting.
The bound only guarantees a finite universe of possible ambient
finite graph shapes at each leaf number.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- The ordered distinct-leaf-pair set has at most |L|^2 elements. -/
theorem finiteOrderedLeafPairs_card_le_square
    (L : Finset Nat) :
    (finiteOrderedLeafPairs L).card ≤ L.card * L.card := by
  classical
  unfold finiteOrderedLeafPairs
  calc
    ((L.product L).filter (fun p => p.1 < p.2)).card ≤
        (L.product L).card :=
      Finset.card_le_card (Finset.filter_subset _ _)
    _ = L.card * L.card := by simp

/-- Singleton meet generators have at most |L|^2 distinct values. -/
theorem finiteOneMeetSupport_card_le_square
    (G : Ordered3Graph Nat) (L : Finset Nat) :
    (finiteOneMeetSupport G L).card ≤ L.card * L.card := by
  classical
  unfold finiteOneMeetSupport
  calc
    (((L.product L).filter (fun p => p.1 ≠ p.2)).image
      (fun p => G.oneMeetLevel p.1 p.2)).card ≤
        ((L.product L).filter (fun p => p.1 ≠ p.2)).card :=
      Finset.card_image_le
    _ ≤ (L.product L).card :=
      Finset.card_le_card (Finset.filter_subset _ _)
    _ = L.card * L.card := by simp

/-- Full ordered-pair meet generators have at most |L|^4
possible values, with repeated pairs and capped meets included. -/
theorem finiteTwoMeetSupport_card_le_fourth
    (G : Ordered3Graph Nat) (L : Finset Nat) :
    (finiteTwoMeetSupport G L).card ≤
      (L.card * L.card) * (L.card * L.card) := by
  classical
  have hp := finiteOrderedLeafPairs_card_le_square L
  unfold finiteTwoMeetSupport
  calc
    (((finiteOrderedLeafPairs L).product
        (finiteOrderedLeafPairs L)).image
          (fun p => G.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2)).card ≤
      ((finiteOrderedLeafPairs L).product
        (finiteOrderedLeafPairs L)).card :=
      Finset.card_image_le
    _ = (finiteOrderedLeafPairs L).card *
        (finiteOrderedLeafPairs L).card := by simp
    _ ≤ (L.card * L.card) * (L.card * L.card) :=
      Nat.mul_le_mul hp hp

/-- Exact leaf-meet support has a polynomial uniform cardinality
bound. This is deliberately independent of whether its induced
reindexing is a diary. -/
theorem finiteLeafMeetSupport_card_le
    (G : Ordered3Graph Nat) (L : Finset Nat) :
    (finiteLeafMeetSupport G L).card ≤
      3 + L.card + L.card * L.card +
        (L.card * L.card) * (L.card * L.card) := by
  classical
  have hLeft :
      (Finset.range 3 ∪ L).card ≤ 3 + L.card := by
    calc
      (Finset.range 3 ∪ L).card ≤
        (Finset.range 3).card + L.card :=
        Finset.card_union_le _ _
      _ = 3 + L.card := by simp
  have hRight :
      (finiteOneMeetSupport G L ∪ finiteTwoMeetSupport G L).card ≤
        (finiteOneMeetSupport G L).card +
          (finiteTwoMeetSupport G L).card :=
    Finset.card_union_le _ _
  have hOne := finiteOneMeetSupport_card_le_square G L
  have hTwo := finiteTwoMeetSupport_card_le_fourth G L
  calc
    (finiteLeafMeetSupport G L).card ≤
        (Finset.range 3 ∪ L).card +
          (finiteOneMeetSupport G L ∪ finiteTwoMeetSupport G L).card := by
      unfold finiteLeafMeetSupport
      exact Finset.card_union_le _ _
    _ ≤ (3 + L.card) +
          ((finiteOneMeetSupport G L).card +
            (finiteTwoMeetSupport G L).card) :=
      Nat.add_le_add hLeft hRight
    _ ≤ 3 + L.card + L.card * L.card +
          (L.card * L.card) * (L.card * L.card) := by omega

/-- In particular all supports generated by at most a selected
leaves have size bounded by ONE fixed natural number. -/
theorem finiteLeafMeetSupport_card_le_of_card_le
    (G : Ordered3Graph Nat) (L : Finset Nat) (a : Nat)
    (hL : L.card ≤ a) :
    (finiteLeafMeetSupport G L).card ≤
      3 + a + a * a + (a * a) * (a * a) := by
  have hSquare : L.card * L.card ≤ a * a :=
    Nat.mul_le_mul hL hL
  have hFourth :
      (L.card * L.card) * (L.card * L.card) ≤
        (a * a) * (a * a) :=
    Nat.mul_le_mul hSquare hSquare
  have hSupport := finiteLeafMeetSupport_card_le G L
  omega

end DiaryLeafPriority
end ThreeUniformDiaries
