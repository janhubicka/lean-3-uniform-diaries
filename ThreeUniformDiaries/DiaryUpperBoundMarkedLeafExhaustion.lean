import ThreeUniformDiaries.DiaryFiniteLeafMeetS1Reduct

/-!
# Track A: prescribed finite leaf markings exhaust the extracted diary

A finite genuine diary support generated by a finite set L of leaves
has NO other genuine leaves. Therefore, if the selected leaves are
exactly the entries of a labelled tuple v and each entry is assigned
its correct source index in the increasing support enumeration, then
EVERY source leaf occurs at one of the marked indices.

The statement is deliberately about source indices and an actual
finite selected support, not about a guessed infinite extension.
It will supply the last leaf-coverage clause in
IsGenuineMarkedDiaryShape for the actual code in Track A #1000.

No order condition on the labels of A, distinctness of v, countable
unavoidability, or full Ramsey theorem is assumed.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

variable {G : Ordered3Graph Nat} {L : Finset Nat} {a : Nat}

/-- Exact exhaustion of the extracted finite diary's genuine
bounded leaves by an arbitrary correctly marked finite leaf
tuple. In particular, the support cannot introduce unmarked
new leaves through capped two-meets. -/
theorem finiteLeafMeetSupport_marking_covers_all_leaves
    (D : RoleDiary G)
    (hLeaves : ∀ u : Nat, u ∈ L → IsLeaf G u)
    (v : Fin a → Nat)
    (hRange : L = (Finset.univ : Finset (Fin a)).image v)
    (marked : Fin a → Fin (finiteLeafMeetSupport G L).card)
    (hMark : ∀ i : Fin a,
      finiteSupportIndex (finiteLeafMeetSupport G L)
        (marked i).val = v i) :
    ∀ u : Nat,
      3 ≤ u →
      u < (finiteLeafMeetSupport G L).card →
      IsLeaf (finiteSupportGraph G (finiteLeafMeetSupport G L)) u →
      ∃ i : Fin a, (marked i).val = u := by
  classical
  let S := finiteLeafMeetSupport G L
  intro u hu3 hu huLeaf
  have hActualLeaf : finiteSupportIndex S u ∈ L :=
    finiteLeafMeetSupport_reindexed_leaf_mem_L
      D hLeaves u hu3 hu huLeaf
  rw [hRange] at hActualLeaf
  obtain ⟨i, _, hValue⟩ := Finset.mem_image.mp hActualLeaf
  have hIndexEq :
      finiteSupportIndex S (marked i).val =
        finiteSupportIndex S u :=
    (hMark i).trans hValue
  have hEq : (marked i).val = u := by
    rcases lt_trichotomy (marked i).val u with hlt | heq | hgt
    · have hStrict :=
        finiteSupportIndex_strictMono S (marked i).val u
          hlt hu
      omega
    · exact heq
    · have hStrict :=
        finiteSupportIndex_strictMono S u (marked i).val
          hgt (marked i).isLt
      omega
  exact ⟨i, hEq⟩

end DiaryLeafPriority
end ThreeUniformDiaries
