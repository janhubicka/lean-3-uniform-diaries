import ThreeUniformDiaries.DiaryCountableCofinalFiniteSupports

/-!
# Exactly one new selected leaf can enter each finite diary support stage

The canonical support S_m is generated by all source leaves at levels
[3,m), and their genuine singleton/full ordered-pair meets.
At successor m+1 this selected leaf set is unchanged unless m is a
genuine leaf, in which case only m is added.

We express the alternatives as ordinary propositions to avoid
inserting a hidden Decidable (IsLeaf H m) assumption in statements.
No target leaf realization or relative fusion is claimed.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- A genuine new leaf m is the only possible additional
selected source leaf at stage m+1. -/
theorem countableDiaryLeafPrefix_succ_of_leaf
    (H : Ordered3Graph Nat) (m : Nat) (hm : IsLeaf H m) :
    countableDiaryLeafPrefix H (m + 1) =
      insert m (countableDiaryLeafPrefix H m) := by
  classical
  ext u
  simp only [mem_countableDiaryLeafPrefix_iff, Finset.mem_insert]
  constructor
  · rintro ⟨hu3,hum,huLeaf⟩
    by_cases hEq : u = m
    · exact Or.inl hEq
    · exact Or.inr ⟨hu3,by omega,huLeaf⟩
  · rintro (rfl | ⟨hu3,hum,huLeaf⟩)
    · exact ⟨hm.1,by omega,hm⟩
    · exact ⟨hu3,by omega,huLeaf⟩

/-- A nonleaf m contributes no selected leaf at this step. -/
theorem countableDiaryLeafPrefix_succ_of_not_leaf
    (H : Ordered3Graph Nat) (m : Nat) (hm : ¬ IsLeaf H m) :
    countableDiaryLeafPrefix H (m + 1) =
      countableDiaryLeafPrefix H m := by
  classical
  ext u
  simp only [mem_countableDiaryLeafPrefix_iff]
  constructor
  · rintro ⟨hu3,hum,huLeaf⟩
    have hNe : u ≠ m := by
      intro hEq
      subst u
      exact hm huLeaf
    exact ⟨hu3,by omega,huLeaf⟩
  · rintro ⟨hu3,hum,huLeaf⟩
    exact ⟨hu3,by omega,huLeaf⟩

/-- A leaf successor is precisely the S1/S2 meet closure
of old selected leaves together with the new leaf m. -/
theorem countableDiaryFiniteSupport_succ_of_leaf
    (H : Ordered3Graph Nat) (m : Nat) (hm : IsLeaf H m) :
    countableDiaryFiniteSupport H (m + 1) =
      finiteLeafMeetSupport H
        (insert m (countableDiaryLeafPrefix H m)) := by
  change finiteLeafMeetSupport H
    (countableDiaryLeafPrefix H (m + 1)) =
      finiteLeafMeetSupport H
        (insert m (countableDiaryLeafPrefix H m))
  rw [countableDiaryLeafPrefix_succ_of_leaf H m hm]

/-- On nonleaf levels, no vertex is added to the generated
finite support (even if that level is itself a split). -/
theorem countableDiaryFiniteSupport_succ_of_not_leaf
    (H : Ordered3Graph Nat) (m : Nat) (hm : ¬ IsLeaf H m) :
    countableDiaryFiniteSupport H (m + 1) =
      countableDiaryFiniteSupport H m := by
  change finiteLeafMeetSupport H
    (countableDiaryLeafPrefix H (m + 1)) =
      finiteLeafMeetSupport H (countableDiaryLeafPrefix H m)
  rw [countableDiaryLeafPrefix_succ_of_not_leaf H m hm]

/-- Every step is exactly one of the two preceding cases. -/
theorem countableDiaryFiniteSupport_succ_cases
    (H : Ordered3Graph Nat) (m : Nat) :
    countableDiaryFiniteSupport H (m + 1) =
        countableDiaryFiniteSupport H m ∨
    countableDiaryFiniteSupport H (m + 1) =
        finiteLeafMeetSupport H
          (insert m (countableDiaryLeafPrefix H m)) := by
  classical
  by_cases hm : IsLeaf H m
  · exact Or.inr (countableDiaryFiniteSupport_succ_of_leaf H m hm)
  · exact Or.inl (countableDiaryFiniteSupport_succ_of_not_leaf H m hm)

end DiaryLeafPriority
end ThreeUniformDiaries
