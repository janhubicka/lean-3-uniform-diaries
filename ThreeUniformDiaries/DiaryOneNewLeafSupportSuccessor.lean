import ThreeUniformDiaries.DiaryCountableCofinalFiniteSupports

/-!
# Exactly one new selected leaf can enter each finite diary support stage

A countable diary's canonical stage S_m is generated by the leaves
at levels [3,m), together with all their S1 and full S2 meets.

At successor m+1, the selected leaf set is UNCHANGED unless m itself
is a genuine source leaf, in which case precisely m is inserted.
The finite support at that stage is obtained by taking the usual
leaf-meet closure of that one extra leaf.

This is an exact source combinatorial identity, not a theorem that
such a new leaf can be embedded into an arbitrary target preserving
a previous finite-stage embedding.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- The selected genuine leaves change at a successor only
by adjoining the single possible new leaf at level m. -/
theorem countableDiaryLeafPrefix_succ
    (H : Ordered3Graph Nat) (m : Nat) :
    countableDiaryLeafPrefix H (m + 1) =
      if IsLeaf H m then
        insert m (countableDiaryLeafPrefix H m)
      else countableDiaryLeafPrefix H m := by
  classical
  by_cases hm : IsLeaf H m
  · simp only [if_pos hm]
    ext u
    simp only [mem_countableDiaryLeafPrefix_iff, Finset.mem_insert]
    constructor
    · rintro ⟨hu3,hum,huLeaf⟩
      by_cases hEq : u = m
      · exact Or.inl hEq
      · exact Or.inr ⟨hu3,by omega,huLeaf⟩
    · rintro (rfl | ⟨hu3,hum,huLeaf⟩)
      · exact ⟨hm.1,by omega,hm⟩
      · exact ⟨hu3,by omega,huLeaf⟩
  · simp only [if_neg hm]
    ext u
    simp only [mem_countableDiaryLeafPrefix_iff]
    constructor
    · rintro ⟨hu3,hum,huLeaf⟩
      have hNe : u ≠ m := by
        intro hEq
        subst u
        exact hm huLeaf
      exact ⟨hu3,by omega,huLeaf⟩
    · rintro ⟨hu3,hum,huLeaf⟩
      exact ⟨hu3,by omega,huLeaf⟩

/-- Exact successor support: either it is unchanged, or
it is the leaf-meet closure after adjoining one genuine leaf. -/
theorem countableDiaryFiniteSupport_succ
    (H : Ordered3Graph Nat) (m : Nat) :
    countableDiaryFiniteSupport H (m + 1) =
      if IsLeaf H m then
        finiteLeafMeetSupport H
          (insert m (countableDiaryLeafPrefix H m))
      else countableDiaryFiniteSupport H m := by
  classical
  by_cases hm : IsLeaf H m
  · simpa only [countableDiaryFiniteSupport,
      countableDiaryLeafPrefix_succ, if_pos hm]
  · simpa only [countableDiaryFiniteSupport,
      countableDiaryLeafPrefix_succ, if_neg hm]

/-- If m is NOT a leaf, no source vertex enters the
canonical generated support at this successor step. -/
theorem countableDiaryFiniteSupport_succ_of_not_leaf
    (H : Ordered3Graph Nat) (m : Nat)
    (hm : ¬ IsLeaf H m) :
    countableDiaryFiniteSupport H (m + 1) =
      countableDiaryFiniteSupport H m := by
  simpa only [if_neg hm] using
    countableDiaryFiniteSupport_succ H m

/-- If m is a leaf, the successor is the finite
S1/S2 closure of the previously selected leaves plus m. -/
theorem countableDiaryFiniteSupport_succ_of_leaf
    (H : Ordered3Graph Nat) (m : Nat)
    (hm : IsLeaf H m) :
    countableDiaryFiniteSupport H (m + 1) =
      finiteLeafMeetSupport H
        (insert m (countableDiaryLeafPrefix H m)) := by
  simpa only [if_pos hm] using
    countableDiaryFiniteSupport_succ H m

end DiaryLeafPriority
end ThreeUniformDiaries
