import ThreeUniformDiaries.DiaryCanonicalMarkedNestedComplete
import ThreeUniformDiaries.DiaryLowerCanonicalMarkedColour
import ThreeUniformDiaries.DiaryCanonicalMarkedRawRestriction

/-!
# Canonical marked source: selected ranks and nested restriction support

The canonical marked diary source for a labelled tuple of genuine
leaves of a full RoleDiary K is not an arbitrary marked shape.
Its exact finite graph and each mark are uniquely determined by
the increasing enumeration of the complete leaf-meet support.

These theorems expose the precise source ranks and the smaller
marked selection support as an equality with the nested support
in the actual countable diary. No countable diary unavoidability
or abstract BRS assumption enters the proof.
-/

namespace ThreeUniformDiaries
namespace ATRFiniteDecoder

open DiaryLeafPriority

/-- A canonical marked source puts EVERY label at exactly the
canonical rank of its ambient leaf in the generated support. -/
theorem canonicalMarkedSourceOfLeaves_marked_rank
    {K : Ordered3Graph Nat} (D : RoleDiary K)
    {a : Nat} (A : EnumNode a)
    (v : Fin a → Nat)
    (hLeaf : ∀ i : Fin a, IsLeaf K (v i))
    (hCopy : IsInducedLabelledCopy A K v)
    (j : Fin a) :
    let S := finiteLeafMeetSupport K
      ((Finset.univ : Finset (Fin a)).image v)
    ((canonicalMarkedSourceOfLeaves D A v hLeaf hCopy).marked j).val =
      finiteSupportRank S (v j) := by
  classical
  let S : Finset Nat :=
    finiteLeafMeetSupport K ((Finset.univ : Finset (Fin a)).image v)
  let P : MarkedFiniteSource 0 a :=
    canonicalMarkedSourceOfLeaves D A v hLeaf hCopy
  obtain ⟨_,hSize,_,hMark⟩ :=
    canonicalMarkedSourceOfLeaves_spec D A v hLeaf hCopy
  have hj : (P.marked j).val < S.card := by
    rw [← hSize]
    exact (P.marked j).isLt
  change (P.marked j).val = finiteSupportRank S (v j)
  calc
    (P.marked j).val =
        finiteSupportRank S (finiteSupportIndex S (P.marked j).val) :=
      (finiteSupportRank_of_index S _ hj).symm
    _ = finiteSupportRank S (v j) := by
      rw [hMark j]

/-- Selecting ANY subtuple in a canonical marked source produces
literally the ranks of that subtuple's ambient genuine leaves.
The label selection need not be numerically increasing. -/
theorem canonicalMarkedSourceOfLeaves_restriction_leaves
    {K : Ordered3Graph Nat} (D : RoleDiary K)
    {a b : Nat} (A : EnumNode a)
    (v : Fin a → Nat)
    (hLeaf : ∀ j : Fin a, IsLeaf K (v j))
    (hCopy : IsInducedLabelledCopy A K v)
    (i : Fin b → Fin a) :
    let L := (Finset.univ : Finset (Fin a)).image v
    let S := finiteLeafMeetSupport K L
    let P := canonicalMarkedSourceOfLeaves D A v hLeaf hCopy
    markedRestrictionLeaves P i =
      ((Finset.univ : Finset (Fin b)).image (fun j => v (i j))).image
        (finiteSupportRank S) := by
  classical
  let L : Finset Nat := (Finset.univ : Finset (Fin a)).image v
  let S : Finset Nat := finiteLeafMeetSupport K L
  let P : MarkedFiniteSource 0 a :=
    canonicalMarkedSourceOfLeaves D A v hLeaf hCopy
  change (Finset.univ : Finset (Fin b)).image
      (fun j => (P.marked (i j)).val) =
    ((Finset.univ : Finset (Fin b)).image
      (fun j => v (i j))).image (finiteSupportRank S)
  rw [Finset.image_image]
  apply Finset.image_congr
  intro j _
  exact canonicalMarkedSourceOfLeaves_marked_rank
    D A v hLeaf hCopy (i j)

/-- The raw-restriction support obtained from the canonical
marked A-code is literally the support generated by the ranks
of the chosen ambient B-leaf subtuple, in the finite canonical
A-diary; this is the input of the verified nested-support theorem. -/
theorem canonicalMarkedSourceOfLeaves_restriction_support
    {K : Ordered3Graph Nat} (D : RoleDiary K)
    {a b : Nat} (A : EnumNode a)
    (v : Fin a → Nat)
    (hLeaf : ∀ j : Fin a, IsLeaf K (v j))
    (hCopy : IsInducedLabelledCopy A K v)
    (i : Fin b → Fin a) :
    let L := (Finset.univ : Finset (Fin a)).image v
    let S := finiteLeafMeetSupport K L
    let L' := (Finset.univ : Finset (Fin b)).image
      (fun j => v (i j))
    let P := canonicalMarkedSourceOfLeaves D A v hLeaf hCopy
    markedRestrictionSupport P i =
      finiteLeafMeetSupport (finiteSupportGraph K S)
        (L'.image (finiteSupportRank S)) := by
  classical
  let L : Finset Nat := (Finset.univ : Finset (Fin a)).image v
  let S : Finset Nat := finiteLeafMeetSupport K L
  let L' : Finset Nat := (Finset.univ : Finset (Fin b)).image
    (fun j => v (i j))
  let P : MarkedFiniteSource 0 a :=
    canonicalMarkedSourceOfLeaves D A v hLeaf hCopy
  have hGraph :
      P.source.picture.toOrdered3Graph = finiteSupportGraph K S :=
    (canonicalMarkedSourceOfLeaves_spec D A v hLeaf hCopy).2.2.1
  have hLeaves :
      markedRestrictionLeaves P i = L'.image (finiteSupportRank S) :=
    canonicalMarkedSourceOfLeaves_restriction_leaves
      D A v hLeaf hCopy i
  change finiteLeafMeetSupport P.source.picture.toOrdered3Graph
      (markedRestrictionLeaves P i) =
    finiteLeafMeetSupport (finiteSupportGraph K S)
      (L'.image (finiteSupportRank S))
  rw [hGraph, hLeaves]

end ATRFiniteDecoder
end ThreeUniformDiaries
