import ThreeUniformDiaries.DiaryFiniteLeafSupportCoversPrefix
import ThreeUniformDiaries.DiaryFiniteFamilyFiniteTarget
import ThreeUniformDiaries.DiaryFiniteBoundedUniversality

/-!
# Track B: protect an old ambient prefix while compressing a whole finite family

The already verified finite-family factorisation selects ONE finite
set of genuine ambient leaves containing all genuine source-copy
leaf images. Independently, every finite numerical prefix of any
genuine countable full RoleDiary is generated by finitely many actual
leaf witnesses. We take BOTH finite sets of leaves together.

Their complete leaf-meet support is a genuine FINITE full diary;
its increasing reindexing fixes every rank below the chosen ambient
prefix, and all original finite family copies survive as bounded,
induced, marker/role and ALL-numerical-meet-preserving embeddings.

This is the promised positive interface for finite compression AFTER
a suitable countable ambient protected embedding has been produced.
It does not construct such an ambient embedding, a relative strong
finite absorber extension, a selected bounded-rank absorber tower,
or countable-source flip absorption.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- Extend a set of genuine ambient leaves by finitely many
additional leaves whose meets generate a given complete numerical
prefix. Reuse the already validated cofinal full-diary support theorem,
not a duplicate induction on V1/V2 witness tuples. -/
theorem RoleDiary.exists_leafSupport_covering_prefix_and_leaves
    {G : Ordered3Graph Nat} (DG : RoleDiary G)
    (p : Nat) (W : Finset Nat)
    (hW : ∀ u : Nat, u ∈ W → IsLeaf G u) :
    ∃ L : Finset Nat,
      W ⊆ L ∧
      (∀ u : Nat, u ∈ L → IsLeaf G u) ∧
      (∀ u : Nat, u < p → u ∈ finiteLeafMeetSupport G L) := by
  classical
  obtain ⟨L₀,hLeaves₀,_hFinite,hRanks⟩ :=
    DG.exists_finite_full_diary_retaining_prefix p
  let L : Finset Nat := L₀ ∪ W
  refine ⟨L,?_,?_,?_⟩
  · intro u hu
    exact Finset.mem_union.mpr (Or.inr hu)
  · intro u hu
    rcases Finset.mem_union.mp hu with hL | hWmem
    · exact hLeaves₀ u hL
    · exact hW u hWmem
  · intro u hu
    obtain ⟨hCard,hIndex⟩ := hRanks u hu
    have hMem : u ∈ finiteLeafMeetSupport G L₀ := by
      have h := finiteSupportIndex_mem
        (finiteLeafMeetSupport G L₀) u hCard
      rw [hIndex] at h
      exact h
    have hSub : L₀ ⊆ L := by
      intro x hx
      exact Finset.mem_union.mpr (Or.inl hx)
    exact finiteLeafMeetSupport_mono G L₀ L hSub hMem

/-- Any already given finite family of genuine finite diary
embeddings into ONE full countable target can be factored into a
single genuinely FINITE full diary while retaining an arbitrary
ambient numerical prefix LITERALLY and preserving all exact
mixed numerical singleton and full pair-type meets of the family copies.

The countable ambient and its source-copy embeddings are INPUTS:
this does not solve the missing protected relative absorber
extension, but shows the subsequent finite-family compression can
be done without disturbing a chosen old prefix. -/
theorem exists_finiteDiary_for_finiteFamily_retaining_ambient_prefix
    {G : Ordered3Graph Nat} (DG : RoleDiary G)
    (p : Nat) (Ds : List FiniteDiaryInput)
    (hCopies : ∀ A : FiniteDiaryInput, A ∈ Ds →
      ∃ f : Nat → Nat,
        FiniteMeetEmbedding A.graph G A.bound f) :
    ∃ (T : Ordered3Graph Nat) (k : Nat),
      FiniteRoleDiaryBlock T k ∧
      (∀ u : Nat, u < p → u < k) ∧
      (∀ a b c : Nat, a < b → b < c → c < p →
        (T.edge a b c ↔ G.edge a b c)) ∧
      (∀ A : FiniteDiaryInput, A ∈ Ds →
        ∃ f : Nat → Nat,
          FiniteBoundedMeetEmbedding A.graph T A.bound k f) := by
  classical
  obtain ⟨W,hW,hWitnesses⟩ :=
    exists_finiteFamily_leaf_support (G := G) Ds hCopies
  obtain ⟨L,hWL,hLeaves,hPrefix⟩ :=
    DG.exists_leafSupport_covering_prefix_and_leaves p W hW
  let S : Finset Nat := finiteLeafMeetSupport G L
  let T : Ordered3Graph Nat := finiteSupportGraph G S
  let k : Nat := S.card
  have hDiary : FiniteRoleDiaryBlock T k := by
    exact finiteLeafMeetSupport_is_finiteDiary DG hLeaves
  have hBound : ∀ u : Nat, u < p → u < k := by
    intro u hu
    have hSpec : finiteSupportRank S u < S.card ∧
        finiteSupportIndex S (finiteSupportRank S u) = u :=
      finiteSupportRank_spec S u (hPrefix u hu)
    have hRank := finiteSupportRank_fixed_prefix S p hPrefix u hu
    rw [hRank] at hSpec
    exact hSpec.1
  have hEdges : ∀ a b c : Nat, a < b → b < c → c < p →
      (T.edge a b c ↔ G.edge a b c) := by
    intro a b c hab hbc hc
    have hcK : c < k := hBound c hc
    have hA := finiteSupportIndex_fixed_prefix S p hPrefix a (by omega)
    have hB := finiteSupportIndex_fixed_prefix S p hPrefix b (by omega)
    have hC := finiteSupportIndex_fixed_prefix S p hPrefix c hc
    have hIff := finiteSupportGraph_edge_iff G S a b c hab hbc hcK
    simpa only [T,hA,hB,hC] using hIff
  refine ⟨T,k,hDiary,hBound,hEdges,?_⟩
  intro A hA
  obtain ⟨f,Ef,hOldImage⟩ := hWitnesses A hA
  have hImageLeaves : ∀ u : Nat, 3 ≤ u → u < A.bound →
      IsLeaf A.graph u → f u ∈ L := by
    intro u hu3 hun hLeaf
    exact hWL (hOldImage u hu3 hun hLeaf)
  have hRange : ∀ u : Nat, u < A.bound → f u ∈ S := by
    exact FiniteMeetEmbedding.range_subset_leafMeetSupport
      A.diary Ef L hImageLeaves
  have hFiniteEmbedding : FiniteMeetEmbedding A.graph T A.bound
      (finiteSupportLift S A.bound f) := by
    exact (FiniteMeetEmbedding.factor_through_leafMeetSupport
      A.diary DG Ef L hLeaves hImageLeaves).2
  refine ⟨finiteSupportLift S A.bound f,⟨hFiniteEmbedding,?_⟩⟩
  intro u hu
  exact (finiteSupportLift_spec S A.bound f hRange u hu).1

end DiaryLeafPriority
end ThreeUniformDiaries
