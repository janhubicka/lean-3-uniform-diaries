import ThreeUniformDiaries.DiaryFiniteLeafMeetSupport
import ThreeUniformDiaries.DiaryTypeRespectingRangeClosure

/-!
# Track B: finite leaf-meet supports are functorial

The diary upper-bound argument needs to identify the finite diary
generated by a selected leaf tuple BEFORE and AFTER the universal
aux-type-respecting embedding of the countable diary.

Here we prove exactly the required finite-support identity: for a
marker-fixing type-respecting induced embedding, the finite set
generated by selected leaves, their one-meets, and their full
ordered-pair two-meets maps ONTO the correspondingly generated set
of their images. It is not merely included in the latter.

This reuses the already verified exact numerical meet transport
through arbitrarily many skipped target levels. It does not assert
the stronger and still-open claim that the finite-support
enumeration itself is an auxiliary-type-respecting embedding of
the complete finite diary. That is a separate mixed-test issue.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- Distinct-leaf singleton-meet generators commute with every
type-respecting induced embedding. No leaf or diary axioms are
needed here; injectivity protects the distinctness filter. -/
theorem finiteOneMeetSupport_image_of_typeRespecting
    {H K : Ordered3Graph Nat}
    (ψ : _root_.ThreeUniformDiaries.Ordered3Graph.Embedding H K) (hψ : ψ.TypeRespecting)
    (L : Finset Nat) :
    (finiteOneMeetSupport H L).image ψ.toFun =
      finiteOneMeetSupport K (L.image ψ.toFun) := by
  classical
  ext m
  constructor
  · intro hm
    obtain ⟨v,hv,hvm⟩ := Finset.mem_image.mp hm
    change v ∈ ((L.product L).filter
      (fun p : Nat × Nat => p.1 ≠ p.2)).image
        (fun p : Nat × Nat => H.oneMeetLevel p.1 p.2) at hv
    obtain ⟨p,hp,hpv⟩ := Finset.mem_image.mp hv
    rcases p with ⟨a,b⟩
    change H.oneMeetLevel a b = v at hpv
    obtain ⟨hp,hab⟩ := Finset.mem_filter.mp hp
    obtain ⟨ha,hb⟩ := Finset.mem_product.mp hp
    have hψne : ψ a ≠ ψ b := by
      intro heq
      exact hab (ψ.strictMono.injective heq)
    have htargetPair :
        (ψ a,ψ b) ∈
          (((L.image ψ.toFun).product (L.image ψ.toFun)).filter
            (fun p : Nat × Nat => p.1 ≠ p.2)) := by
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_product.mpr ⟨?_, ?_⟩,hψne⟩
      · exact Finset.mem_image.mpr ⟨a,ha,rfl⟩
      · exact Finset.mem_image.mpr ⟨b,hb,rfl⟩
    change m ∈
      (((L.image ψ.toFun).product (L.image ψ.toFun)).filter
        (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => K.oneMeetLevel p.1 p.2)
    apply Finset.mem_image.mpr
    refine ⟨(ψ a,ψ b),htargetPair,?_⟩
    change K.oneMeetLevel (ψ a) (ψ b) = m
    calc
      K.oneMeetLevel (ψ a) (ψ b) =
          ψ (H.oneMeetLevel a b) :=
        _root_.ThreeUniformDiaries.Ordered3Graph.typeRespecting_oneMeetLevel_eq ψ hψ a b
      _ = ψ v := congrArg ψ hpv
      _ = m := hvm
  · intro hm
    change m ∈
      (((L.image ψ.toFun).product (L.image ψ.toFun)).filter
        (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => K.oneMeetLevel p.1 p.2) at hm
    obtain ⟨p,hp,hpm⟩ := Finset.mem_image.mp hm
    rcases p with ⟨u,v⟩
    change K.oneMeetLevel u v = m at hpm
    obtain ⟨hp,huv⟩ := Finset.mem_filter.mp hp
    obtain ⟨hu,hv⟩ := Finset.mem_product.mp hp
    obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨b,hb,rfl⟩ := Finset.mem_image.mp hv
    have hab : a ≠ b := by
      intro heq
      subst b
      exact huv rfl
    have hsource :
        H.oneMeetLevel a b ∈ finiteOneMeetSupport H L := by
      change H.oneMeetLevel a b ∈ ((L.product L).filter
        (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => H.oneMeetLevel p.1 p.2)
      apply Finset.mem_image.mpr
      refine ⟨(a,b),?_,rfl⟩
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_product.mpr ⟨ha,hb⟩,hab⟩
    apply Finset.mem_image.mpr
    refine ⟨H.oneMeetLevel a b,hsource,?_⟩
    change ψ (H.oneMeetLevel a b) = m
    exact (_root_.ThreeUniformDiaries.Ordered3Graph.typeRespecting_oneMeetLevel_eq ψ hψ a b).symm.trans hpm

/-- The full ordered-pair meet generator set is also exactly
transported. Reflection of the strict order of selected pairs
is essential in the reverse inclusion. -/
theorem finiteTwoMeetSupport_image_of_typeRespecting
    {H K : Ordered3Graph Nat}
    (ψ : _root_.ThreeUniformDiaries.Ordered3Graph.Embedding H K) (hψ : ψ.TypeRespecting)
    (L : Finset Nat) :
    (finiteTwoMeetSupport H L).image ψ.toFun =
      finiteTwoMeetSupport K (L.image ψ.toFun) := by
  classical
  ext m
  constructor
  · intro hm
    obtain ⟨v,hv,hvm⟩ := Finset.mem_image.mp hm
    change v ∈ ((finiteOrderedLeafPairs L).product
      (finiteOrderedLeafPairs L)).image
        (fun p : (Nat × Nat) × (Nat × Nat) =>
          H.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hv
    obtain ⟨p,hp,hpv⟩ := Finset.mem_image.mp hv
    rcases p with ⟨⟨a,b⟩,⟨c,d⟩⟩
    change H.twoMeetLevel a b c d = v at hpv
    obtain ⟨habmem,hcdmem⟩ := Finset.mem_product.mp hp
    obtain ⟨habbase,hab⟩ := Finset.mem_filter.mp habmem
    obtain ⟨hcdbase,hcd⟩ := Finset.mem_filter.mp hcdmem
    obtain ⟨ha,hb⟩ := Finset.mem_product.mp habbase
    obtain ⟨hc,hd⟩ := Finset.mem_product.mp hcdbase
    have hAB : (ψ a,ψ b) ∈
        finiteOrderedLeafPairs (L.image ψ.toFun) := by
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_product.mpr ⟨?_,?_⟩,ψ.strictMono hab⟩
      · exact Finset.mem_image.mpr ⟨a,ha,rfl⟩
      · exact Finset.mem_image.mpr ⟨b,hb,rfl⟩
    have hCD : (ψ c,ψ d) ∈
        finiteOrderedLeafPairs (L.image ψ.toFun) := by
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_product.mpr ⟨?_,?_⟩,ψ.strictMono hcd⟩
      · exact Finset.mem_image.mpr ⟨c,hc,rfl⟩
      · exact Finset.mem_image.mpr ⟨d,hd,rfl⟩
    change m ∈ ((finiteOrderedLeafPairs (L.image ψ.toFun)).product
      (finiteOrderedLeafPairs (L.image ψ.toFun))).image
        (fun p : (Nat × Nat) × (Nat × Nat) =>
          K.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2)
    apply Finset.mem_image.mpr
    refine ⟨((ψ a,ψ b),(ψ c,ψ d)),
      Finset.mem_product.mpr ⟨hAB,hCD⟩,?_⟩
    change K.twoMeetLevel (ψ a) (ψ b) (ψ c) (ψ d) = m
    calc
      K.twoMeetLevel (ψ a) (ψ b) (ψ c) (ψ d) =
          ψ (H.twoMeetLevel a b c d) :=
        _root_.ThreeUniformDiaries.Ordered3Graph.typeRespecting_twoMeetLevel_eq ψ hψ a b c d hab hcd
      _ = ψ v := congrArg ψ hpv
      _ = m := hvm
  · intro hm
    change m ∈ ((finiteOrderedLeafPairs (L.image ψ.toFun)).product
      (finiteOrderedLeafPairs (L.image ψ.toFun))).image
        (fun p : (Nat × Nat) × (Nat × Nat) =>
          K.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hm
    obtain ⟨p,hp,hpm⟩ := Finset.mem_image.mp hm
    rcases p with ⟨⟨u,v⟩,⟨x,y⟩⟩
    change K.twoMeetLevel u v x y = m at hpm
    obtain ⟨habmem,hcdmem⟩ := Finset.mem_product.mp hp
    obtain ⟨habbase,huv⟩ := Finset.mem_filter.mp habmem
    obtain ⟨hcdbase,hxy⟩ := Finset.mem_filter.mp hcdmem
    obtain ⟨hu,hv⟩ := Finset.mem_product.mp habbase
    obtain ⟨hx,hy⟩ := Finset.mem_product.mp hcdbase
    obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨b,hb,rfl⟩ := Finset.mem_image.mp hv
    obtain ⟨c,hc,rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨d,hd,rfl⟩ := Finset.mem_image.mp hy
    have hab : a < b := by
      by_contra hn
      have hba : b ≤ a := Nat.le_of_not_gt hn
      exact (not_lt_of_ge (ψ.strictMono.monotone hba)) huv
    have hcd : c < d := by
      by_contra hn
      have hdc : d ≤ c := Nat.le_of_not_gt hn
      exact (not_lt_of_ge (ψ.strictMono.monotone hdc)) hxy
    have hAB : (a,b) ∈ finiteOrderedLeafPairs L :=
      Finset.mem_filter.mpr
        ⟨Finset.mem_product.mpr ⟨ha,hb⟩,hab⟩
    have hCD : (c,d) ∈ finiteOrderedLeafPairs L :=
      Finset.mem_filter.mpr
        ⟨Finset.mem_product.mpr ⟨hc,hd⟩,hcd⟩
    have hsource : H.twoMeetLevel a b c d ∈
        finiteTwoMeetSupport H L := by
      change H.twoMeetLevel a b c d ∈
        ((finiteOrderedLeafPairs L).product
          (finiteOrderedLeafPairs L)).image
            (fun p : (Nat × Nat) × (Nat × Nat) =>
              H.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2)
      exact Finset.mem_image.mpr
        ⟨((a,b),(c,d)),Finset.mem_product.mpr ⟨hAB,hCD⟩,rfl⟩
    apply Finset.mem_image.mpr
    refine ⟨H.twoMeetLevel a b c d,hsource,?_⟩
    change ψ (H.twoMeetLevel a b c d) = m
    exact (_root_.ThreeUniformDiaries.Ordered3Graph.typeRespecting_twoMeetLevel_eq ψ hψ
      a b c d hab hcd).symm.trans hpm

/-- Main functoriality identity. If the first three markers are fixed,
the *entire* finite generated leaf-meet carrier is transported
bijectively onto the target carrier generated by the leaf images.
No diary-specific split/leaf role axioms are required. -/
theorem finiteLeafMeetSupport_image_of_typeRespecting
    {H K : Ordered3Graph Nat}
    (ψ : _root_.ThreeUniformDiaries.Ordered3Graph.Embedding H K) (hψ : ψ.TypeRespecting)
    (hfix : ∀ i, i < 3 → ψ i = i)
    (L : Finset Nat) :
    (finiteLeafMeetSupport H L).image ψ.toFun =
      finiteLeafMeetSupport K (L.image ψ.toFun) := by
  classical
  have hMarkers :
      (Finset.range 3).image ψ.toFun = Finset.range 3 := by
    ext x
    constructor
    · intro hx
      obtain ⟨u,hu,hux⟩ := Finset.mem_image.mp hx
      have hu3 : u < 3 := Finset.mem_range.mp hu
      have hfx := hfix u hu3
      rw [hfx] at hux
      exact Finset.mem_range.mpr (by omega)
    · intro hx
      exact Finset.mem_image.mpr
        ⟨x,hx,hfix x (Finset.mem_range.mp hx)⟩
  have hOne :=
    finiteOneMeetSupport_image_of_typeRespecting ψ hψ L
  have hTwo :=
    finiteTwoMeetSupport_image_of_typeRespecting ψ hψ L
  change
    (((Finset.range 3 ∪ L) ∪
      (finiteOneMeetSupport H L ∪ finiteTwoMeetSupport H L)).image
      ψ.toFun) =
    ((Finset.range 3 ∪ L.image ψ.toFun) ∪
      (finiteOneMeetSupport K (L.image ψ.toFun) ∪
       finiteTwoMeetSupport K (L.image ψ.toFun)))
  simp only [Finset.image_union, hMarkers, hOne, hTwo]

end DiaryLeafPriority
end ThreeUniformDiaries
