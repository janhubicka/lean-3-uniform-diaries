import ThreeUniformDiaries.DiaryUnboundedSingletonTypes
import ThreeUniformDiaries.DiaryFiniteSingletonATR

/-!
# Arbitrarily late *actual finite ATR copies* of a singleton envelope

The generic extension property gives arbitrarily late vertices of
any chosen singleton type over the fixed prefix. The finite
singleton envelope generated by such a vertex has exactly the same
EnumNode (n+1) source as the original envelope, not merely an
isomorphic infinite zero-extension. This provides genuine
FiniteAuxEmbeddingImage witnesses whose first n vertices are fixed
and whose last image is arbitrarily large.

These are the real witnesses needed to rule out the forbidden
homogeneous colour in the lower-bound finite-avoidance argument.
-/

namespace ThreeUniformDiaries
namespace Ordered3Graph
namespace FiniteSingletonEnvelope

variable {K : Ordered3Graph Nat} {n a b : Nat}

/-- Equality of singleton types below the protected cut implies
equality of the two exact finite enumerated envelope sources.
The argument compares every increasing triple on their n+1 real
vertices, and checks support for the other triples. -/
theorem finiteEnum_eq_of_sameOneType
    (E : FiniteSingletonEnvelope K n a)
    (T : FiniteSingletonEnvelope K n b)
    (htype : K.SameOneTypeBelow n a b) :
    E.finiteEnum = T.finiteEnum := by
  classical
  apply EnumNode.ext_triples
  funext x y z
  by_cases hvalid : x < y ∧ y < z ∧ z < n+1
  · obtain ⟨hxy, hyz, hzn⟩ := hvalid
    have hx : x < n := by omega
    have hy : y < n := by omega
    have hedges :
        K.edge (E.enumerate x) (E.enumerate y) (E.enumerate z) ↔
        K.edge (T.enumerate x) (T.enumerate y) (T.enumerate z) := by
      by_cases hpre : z < n
      · simp only [E.protected_prefix x hx,
          E.protected_prefix y hy, E.protected_prefix z hpre,
          T.protected_prefix x hx, T.protected_prefix y hy,
          T.protected_prefix z hpre]
      · have hzEq : z = n := by omega
        simpa only [E.protected_prefix x hx,
          E.protected_prefix y hy,
          T.protected_prefix x hx, T.protected_prefix y hy,
          hzEq, E.endpoint, T.endpoint] using
          htype hxy hy
    change decide (x < y ∧ y < z ∧ z < n+1 ∧
        K.edge (E.enumerate x) (E.enumerate y) (E.enumerate z)) =
      decide (x < y ∧ y < z ∧ z < n+1 ∧
        K.edge (T.enumerate x) (T.enumerate y) (T.enumerate z))
    by_cases he : K.edge (E.enumerate x) (E.enumerate y) (E.enumerate z) <;>
      by_cases ht : K.edge (T.enumerate x) (T.enumerate y) (T.enumerate z)
    all_goals simp_all [hxy, hyz, hzn, he, ht]
  · have hE := E.finiteEnum.support x y z hvalid
    have hT := T.finiteEnum.support x y z hvalid
    exact hE.trans hT.symm

end FiniteSingletonEnvelope
end Ordered3Graph

namespace GenericEnumerated3Graph

open Ordered3Graph

/-- Every genuine finite singleton-envelope source has a
prefix-fixing actual finite ATR embedding whose last vertex is
greater than any requested bound. -/
theorem exists_late_singleton_finiteATRCode
    (G : GenericEnumerated3Graph)
    {n a : Nat}
    (E : FiniteSingletonEnvelope G.graph n a)
    (B : Nat) :
    ∃ (v : Nat), B < v ∧
      ∃ e : FiniteAuxEmbeddingImage
          E.finiteEnum.toOrdered3Graph G.graph (n+1),
        (∀ i : Fin (n+1), i.val < n → e.image i = i.val) ∧
        e.image ⟨n, Nat.lt_succ_self n⟩ = v := by
  obtain ⟨v, hvn, hvB, htype⟩ :=
    G.exists_late_same_one_type n a B
  let T : FiniteSingletonEnvelope G.graph n v :=
    FiniteSingletonEnvelope.ofVertex G.graph n v hvn
  have hEnum : E.finiteEnum = T.finiteEnum :=
    E.finiteEnum_eq_of_sameOneType T htype
  have hf : FiniteAuxEmbedding
      E.finiteEnum.toOrdered3Graph G.graph T.enumerate (n+1) := by
    rw [hEnum]
    exact T.finite_aux_embedding.of_initialSegment
  let e : FiniteAuxEmbeddingImage
      E.finiteEnum.toOrdered3Graph G.graph (n+1) :=
    FiniteAuxEmbeddingImage.ofFiniteAuxEmbedding T.enumerate hf
  refine ⟨v, hvB, e, ?_, ?_⟩
  · intro i hi
    change T.enumerate i.val = i.val
    exact T.protected_prefix i.val hi
  · change T.enumerate n = v
    exact T.endpoint

end GenericEnumerated3Graph
end ThreeUniformDiaries
