import ThreeUniformDiaries.DiaryFiniteMeetEmbedding
import ThreeUniformDiaries.DiaryFiniteFamilyJointEmbedding
import ThreeUniformDiaries.DiaryProtectedMixedFullMeets

/-!
# Finite support generated by a finite set of diary leaves

This is the first, deliberately modest formal step towards a
finite diary extraction from a countable completed RoleDiary.

Given a finite leaf set L, select the three initial markers,
all leaves of L, all singleton meets of DISTINCT leaves of L,
and all full ordered-pair meets of ordered leaf pairs in L.
This set is finite and uses the exact manuscript S2 cap shape.

We prove that an induced finite meet embedding of a finite diary
whose source leaves all land in L has its ENTIRE finite image in
this generated support. Each source split is generated by actual
bounded V1/V2 witnesses in its own diary, and their meets are
preserved by the supplied embedding.

The major remaining lemma is that increasing reindexing of the
induced support yields a FINITE diary and preserves the numerical
meets of the already embedded input diaries. Nothing in this
module assumes or asserts that lemma or every-flip absorption.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- The complete set of ordered pairs from a finite leaf set. -/
def finiteOrderedLeafPairs (L : Finset Nat) : Finset (Nat × Nat) :=
  (L.product L).filter (fun p => p.1 < p.2)

/-- Exact singleton meet levels generated by DISTINCT leaves. -/
def finiteOneMeetSupport
    (G : Ordered3Graph Nat) (L : Finset Nat) : Finset Nat :=
  ((L.product L).filter (fun p => p.1 ≠ p.2)).image
    (fun p => G.oneMeetLevel p.1 p.2)

/-- Full ordered-pair meet levels generated by ordered leaf pairs. -/
def finiteTwoMeetSupport
    (G : Ordered3Graph Nat) (L : Finset Nat) : Finset Nat :=
  ((finiteOrderedLeafPairs L).product (finiteOrderedLeafPairs L)).image
    (fun p => G.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2)

/-- Marker-complete finite leaf-meet support of a selected leaf set. -/
def finiteLeafMeetSupport
    (G : Ordered3Graph Nat) (L : Finset Nat) : Finset Nat :=
  (Finset.range 3 ∪ L) ∪
    (finiteOneMeetSupport G L ∪ finiteTwoMeetSupport G L)

/-- The three distinguished markers always belong to the support. -/
theorem mem_finiteLeafMeetSupport_marker
    (G : Ordered3Graph Nat) (L : Finset Nat)
    (u : Nat) (hu : u < 3) :
    u ∈ finiteLeafMeetSupport G L := by
  exact Finset.mem_union.mpr
    (Or.inl (Finset.mem_union.mpr
      (Or.inl (Finset.mem_range.mpr hu))))

/-- Every selected leaf belongs to its generated support. -/
theorem mem_finiteLeafMeetSupport_leaf
    (G : Ordered3Graph Nat) (L : Finset Nat)
    (u : Nat) (hu : u ∈ L) :
    u ∈ finiteLeafMeetSupport G L := by
  exact Finset.mem_union.mpr
    (Or.inl (Finset.mem_union.mpr (Or.inr hu)))

/-- The exact singleton meet of any two distinct selected leaves
is a vertex of the generated finite support. -/
theorem mem_finiteLeafMeetSupport_oneMeet
    (G : Ordered3Graph Nat) (L : Finset Nat)
    (a b : Nat) (ha : a ∈ L) (hb : b ∈ L)
    (hne : a ≠ b) :
    G.oneMeetLevel a b ∈ finiteLeafMeetSupport G L := by
  have hp : (a,b) ∈
      (L.product L).filter (fun p => p.1 ≠ p.2) :=
    Finset.mem_filter.mpr
      ⟨Finset.mem_product.mpr ⟨ha,hb⟩,hne⟩
  have hm : G.oneMeetLevel a b ∈ finiteOneMeetSupport G L :=
    Finset.mem_image.mpr ⟨(a,b),hp,rfl⟩
  exact Finset.mem_union.mpr
    (Or.inr (Finset.mem_union.mpr (Or.inl hm)))

/-- The exact full meet of any two ordered selected leaf pairs
belongs to the generated finite support, including marker/cap
cases and genuine two-split cases. -/
theorem mem_finiteLeafMeetSupport_twoMeet
    (G : Ordered3Graph Nat) (L : Finset Nat)
    (a b c d : Nat) (hab : a < b) (hcd : c < d)
    (ha : a ∈ L) (hb : b ∈ L)
    (hc : c ∈ L) (hd : d ∈ L) :
    G.twoMeetLevel a b c d ∈ finiteLeafMeetSupport G L := by
  have habP : (a,b) ∈ finiteOrderedLeafPairs L :=
    Finset.mem_filter.mpr
      ⟨Finset.mem_product.mpr ⟨ha,hb⟩,hab⟩
  have hcdP : (c,d) ∈ finiteOrderedLeafPairs L :=
    Finset.mem_filter.mpr
      ⟨Finset.mem_product.mpr ⟨hc,hd⟩,hcd⟩
  have hp : ((a,b),(c,d)) ∈
      (finiteOrderedLeafPairs L).product (finiteOrderedLeafPairs L) :=
    Finset.mem_product.mpr ⟨habP,hcdP⟩
  have hm : G.twoMeetLevel a b c d ∈ finiteTwoMeetSupport G L :=
    Finset.mem_image.mpr ⟨((a,b),(c,d)),hp,rfl⟩
  exact Finset.mem_union.mpr
    (Or.inr (Finset.mem_union.mpr (Or.inr hm)))

variable {A G : Ordered3Graph Nat} {n : Nat} {f : Nat → Nat}

/-- Every vertex of a genuinely bounded finite diary copy is
generated by the image leaves and their meets. More precisely,
if f is an induced, role- and numerical-meet-preserving finite
embedding, and L contains all its source leaf images, then
the ENTIRE source interval [0,n) lands in finiteLeafMeetSupport G L.

The proof uses source V1/V2 witnesses for the two split roles
and hence also works with mixed split/leaf numerical source
meet requirements. This is a finite support membership lemma,
NOT a claim that its induced restriction is yet a finite diary. -/
theorem FiniteMeetEmbedding.range_subset_leafMeetSupport
    (DA : FiniteRoleDiaryBlock A n)
    (E : FiniteMeetEmbedding A G n f)
    (L : Finset Nat)
    (hLeaves : ∀ u : Nat, 3 ≤ u → u < n →
      IsLeaf A u → f u ∈ L) :
    ∀ u : Nat, u < n → f u ∈ finiteLeafMeetSupport G L := by
  intro u hun
  by_cases hu3 : 3 ≤ u
  · rcases DA.prediary.role_valid u hu3 hun with hLeaf | hOne | hTwo
    · exact mem_finiteLeafMeetSupport_leaf G L
        (f u) (hLeaves u hu3 hun hLeaf)
    · obtain ⟨a,b,han,hbn,ha,hb,hua,hub,hMeet⟩ :=
        DA.prediary.one_split_witness u hOne hun
      have hFa := hLeaves a ha.1 han ha
      have hFb := hLeaves b hb.1 hbn hb
      have hne : a ≠ b := by
        intro hab
        subst b
        have hSelf := A.oneMeetLevel_self a
        omega
      have hSource := E.oneMeet a b
        ha.1 han hb.1 hbn
      have hm : G.oneMeetLevel (f a) (f b) = f u := by
        rw [hSource,hMeet]
      rw [← hm]
      exact mem_finiteLeafMeetSupport_oneMeet G L
        (f a) (f b) hFa hFb
        (E.strictMono.injective.ne hne)
    · obtain ⟨a,b,c,d,hab,hcd,han,hbn,hcn,hdn,
        ha,hb,hc,hd,hua,huc,hMeet⟩ :=
        DA.prediary.two_split_witness u hTwo hun
      have hFa := hLeaves a ha.1 han ha
      have hFb := hLeaves b hb.1 hbn hb
      have hFc := hLeaves c hc.1 hcn hc
      have hFd := hLeaves d hd.1 hdn hd
      have hSource := E.twoMeet a b c d hab hcd
        ha.1 han hb.1 hbn hc.1 hcn hd.1 hdn
      have hm : G.twoMeetLevel (f a) (f b) (f c) (f d) = f u := by
        rw [hSource,hMeet]
      rw [← hm]
      exact mem_finiteLeafMeetSupport_twoMeet G L
        (f a) (f b) (f c) (f d)
        (E.strictMono hab) (E.strictMono hcd)
        hFa hFb hFc hFd
  · have huSmall : u < 3 := by omega
    have hCases : u = 0 ∨ u = 1 ∨ u = 2 := by omega
    rcases hCases with h0 | h1 | h2
    · subst u
      rw [E.marker_zero]
      exact mem_finiteLeafMeetSupport_marker G L 0 (by omega)
    · subst u
      rw [E.marker_one]
      exact mem_finiteLeafMeetSupport_marker G L 1 (by omega)
    · subst u
      rw [E.marker_two]
      exact mem_finiteLeafMeetSupport_marker G L 2 (by omega)

end DiaryLeafPriority
end ThreeUniformDiaries
