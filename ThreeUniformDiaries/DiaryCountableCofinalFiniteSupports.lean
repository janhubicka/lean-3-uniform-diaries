import ThreeUniformDiaries.DiaryFiniteLeafMeetCompleteReduct
import ThreeUniformDiaries.DiaryFiniteLeafMeetSupport
import ThreeUniformDiaries.DiaryFullRoleDefinition

/-!
# A cofinal increasing sequence of finite full subdiaries

A countable full diary D on Nat is exhausted by the exact finite
leaf-meet supports generated by successively longer prefixes of
its genuine leaves. The supports include markers 0,1,2 and all
singleton/full ordered-pair meets of selected leaves.

At each natural cutoff m, retain precisely the TRUE leaves below m
and all their genuine S1/S2 meets. The resulting finite support
is a complete finite full RoleDiary block after its increasing
induced reindexing. These supports are monotone as SUBSETS of
the original countable carrier, and every original diary vertex
eventually lies in every later support. The non-leaf cases use
the actual V1/V2 split witnesses, not an unsupported assumption
that finite enumerated prefixes are automatically full diaries.

This is a precise cofinal-chain input for the countable-source
unavoidability/fusion problem. It does NOT supply coherent
source embeddings of the chain into a prescribed leaf range
and therefore does not prove the full countable-source lower bound.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- The set of all actual diary leaves in the numerical prefix
[3,m) of a countable role diary, not all vertices of that prefix. -/
noncomputable def countableDiaryLeafPrefix
    (G : Ordered3Graph Nat) (m : Nat) : Finset Nat := by
  classical
  exact (Finset.Ico 3 m).filter (fun u => IsLeaf G u)

/-- Literal membership criterion for selected genuine prefix leaves. -/
theorem mem_countableDiaryLeafPrefix_iff
    (G : Ordered3Graph Nat) (m u : Nat) :
    u ∈ countableDiaryLeafPrefix G m ↔
      3 ≤ u ∧ u < m ∧ IsLeaf G u := by
  classical
  simp [countableDiaryLeafPrefix, and_assoc]

/-- Monotonicity of the actual finite selected leaf prefixes. -/
theorem countableDiaryLeafPrefix_mono
    (G : Ordered3Graph Nat) (m n : Nat)
    (hmn : m ≤ n) :
    countableDiaryLeafPrefix G m ⊆
      countableDiaryLeafPrefix G n := by
  intro u hu
  obtain ⟨h3,hum,hLeaf⟩ :=
    (mem_countableDiaryLeafPrefix_iff G m u).mp hu
  exact (mem_countableDiaryLeafPrefix_iff G n u).mpr
    ⟨h3,by omega,hLeaf⟩

/-- Generating a finite leaf-meet support is monotone in its
chosen set of leaves. This is an exact set-theoretic theorem
for arbitrary ordered ternary graphs; no convexity of supports,
ambient diary axioms, or type reflection is needed. -/
theorem finiteLeafMeetSupport_mono
    (G : Ordered3Graph Nat) (L M : Finset Nat)
    (hLM : L ⊆ M) :
    finiteLeafMeetSupport G L ⊆ finiteLeafMeetSupport G M := by
  classical
  intro u hu
  change u ∈ (Finset.range 3 ∪ L) ∪
    (finiteOneMeetSupport G L ∪ finiteTwoMeetSupport G L) at hu
  rcases Finset.mem_union.mp hu with hFront | hMeets
  · rcases Finset.mem_union.mp hFront with hMarker | hLeaf
    · exact mem_finiteLeafMeetSupport_marker G M u
        (Finset.mem_range.mp hMarker)
    · exact mem_finiteLeafMeetSupport_leaf G M u
        (hLM hLeaf)
  · rcases Finset.mem_union.mp hMeets with hOne | hTwo
    · change u ∈ ((L.product L).filter
        (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => G.oneMeetLevel p.1 p.2) at hOne
      obtain ⟨⟨a,b⟩,hp,hEq⟩ := Finset.mem_image.mp hOne
      obtain ⟨hp,hne⟩ := Finset.mem_filter.mp hp
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hp
      rw [← hEq]
      exact mem_finiteLeafMeetSupport_oneMeet
        G M a b (hLM ha) (hLM hb) hne
    · change u ∈
        ((finiteOrderedLeafPairs L).product
          (finiteOrderedLeafPairs L)).image
          (fun p : (Nat × Nat) × (Nat × Nat) =>
            G.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hTwo
      obtain ⟨⟨⟨a,b⟩,⟨c,d⟩⟩,hp,hEq⟩ :=
        Finset.mem_image.mp hTwo
      obtain ⟨hpAB,hpCD⟩ := Finset.mem_product.mp hp
      obtain ⟨hpA,hab⟩ := Finset.mem_filter.mp hpAB
      obtain ⟨hpC,hcd⟩ := Finset.mem_filter.mp hpCD
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hpA
      obtain ⟨hc,hd⟩ := Finset.mem_product.mp hpC
      rw [← hEq]
      exact mem_finiteLeafMeetSupport_twoMeet G M
        a b c d hab hcd (hLM ha) (hLM hb) (hLM hc) (hLM hd)

/-- The actual increasing chain of finite supports in a
countable diary, including markers and the genuine S1/S2
generators of the leaf prefix. -/
noncomputable def countableDiaryFiniteSupport
    (G : Ordered3Graph Nat) (m : Nat) : Finset Nat :=
  finiteLeafMeetSupport G (countableDiaryLeafPrefix G m)

theorem countableDiaryFiniteSupport_mono
    (G : Ordered3Graph Nat) (m n : Nat)
    (hmn : m ≤ n) :
    countableDiaryFiniteSupport G m ⊆
      countableDiaryFiniteSupport G n :=
  finiteLeafMeetSupport_mono G
    (countableDiaryLeafPrefix G m)
    (countableDiaryLeafPrefix G n)
    (countableDiaryLeafPrefix_mono G m n hmn)

/-- Every stage is a genuine FINITE full diary after exact
increasing induced reindexing. Naive initial segments would
not necessarily retain V1/V2 split witnesses. -/
theorem countableDiaryFiniteSupport_is_finiteDiary
    {G : Ordered3Graph Nat} (D : RoleDiary G) (m : Nat) :
    FiniteRoleDiaryBlock
      (finiteSupportGraph G (countableDiaryFiniteSupport G m))
      (countableDiaryFiniteSupport G m).card := by
  let L := countableDiaryLeafPrefix G m
  have hLeaves : ∀ u : Nat, u ∈ L → IsLeaf G u := by
    intro u hu
    exact ((mem_countableDiaryLeafPrefix_iff G m u).mp hu).2.2
  exact finiteLeafMeetSupport_is_finiteDiary D hLeaves

/-- Cofinality: every vertex of any countable full diary lies
in ALL sufficiently long finite leaf-meet supports. Its genuine
role determines how to select a finite witness cutoff:
* markers belong to every support;
* leaves are selected directly;
* a 1-split is the meet of two later genuine leaves;
* a 2-split is the full meet of two ordered later leaf pairs.

This makes the supports an exhaustive chain of ACTUAL finite
vertex subsets, not a statement about independent embeddings
or any arbitrary chosen nested copies in the target. -/
theorem countableDiaryFiniteSupport_eventually_contains
    {G : Ordered3Graph Nat} (D : RoleDiary G) (u : Nat) :
    ∃ m : Nat, ∀ n : Nat, m ≤ n →
      u ∈ countableDiaryFiniteSupport G n := by
  classical
  by_cases hu3 : 3 ≤ u
  · rcases D.role_valid u hu3 with hLeaf | hOne | hTwo
    · refine ⟨u+1,?_⟩
      intro n hn
      exact mem_finiteLeafMeetSupport_leaf G
        (countableDiaryLeafPrefix G n) u
        ((mem_countableDiaryLeafPrefix_iff G n u).mpr
          ⟨hu3,by omega,hLeaf⟩)
    · obtain ⟨a,b,ha,hb,hua,hub,hMeet⟩ :=
        D.one_split_witness u hOne
      let m := max a b + 1
      refine ⟨m,?_⟩
      intro n hmn
      have hLa : a ∈ countableDiaryLeafPrefix G n :=
        (mem_countableDiaryLeafPrefix_iff G n a).mpr
          ⟨ha.1,by dsimp [m] at hmn; omega,ha⟩
      have hLb : b ∈ countableDiaryLeafPrefix G n :=
        (mem_countableDiaryLeafPrefix_iff G n b).mpr
          ⟨hb.1,by dsimp [m] at hmn; omega,hb⟩
      have hne : a ≠ b := by
        intro hEq
        subst b
        have hSelf := Ordered3Graph.oneMeetLevel_self G a
        omega
      rw [← hMeet]
      exact mem_finiteLeafMeetSupport_oneMeet G
        (countableDiaryLeafPrefix G n) a b hLa hLb hne
    · obtain ⟨a,b,c,d,hab,hcd,ha,hb,hc,hd,
        hua,huc,hMeet⟩ :=
        D.two_split_witness u hTwo
      let m := max (max a b) (max c d) + 1
      refine ⟨m,?_⟩
      intro n hmn
      have hLa : a ∈ countableDiaryLeafPrefix G n :=
        (mem_countableDiaryLeafPrefix_iff G n a).mpr
          ⟨ha.1,by dsimp [m] at hmn; omega,ha⟩
      have hLb : b ∈ countableDiaryLeafPrefix G n :=
        (mem_countableDiaryLeafPrefix_iff G n b).mpr
          ⟨hb.1,by dsimp [m] at hmn; omega,hb⟩
      have hLc : c ∈ countableDiaryLeafPrefix G n :=
        (mem_countableDiaryLeafPrefix_iff G n c).mpr
          ⟨hc.1,by dsimp [m] at hmn; omega,hc⟩
      have hLd : d ∈ countableDiaryLeafPrefix G n :=
        (mem_countableDiaryLeafPrefix_iff G n d).mpr
          ⟨hd.1,by dsimp [m] at hmn; omega,hd⟩
      rw [← hMeet]
      exact mem_finiteLeafMeetSupport_twoMeet G
        (countableDiaryLeafPrefix G n)
        a b c d hab hcd hLa hLb hLc hLd
  · have hlt : u < 3 := by omega
    exact ⟨0,by
      intro n _
      exact mem_finiteLeafMeetSupport_marker G
        (countableDiaryLeafPrefix G n) u hlt⟩

end DiaryLeafPriority
end ThreeUniformDiaries
