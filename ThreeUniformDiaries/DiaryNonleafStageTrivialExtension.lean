import ThreeUniformDiaries.DiaryLeafGeneratedStageCompatibility

/-!
# Every nonleaf stage extends automatically

The canonical countable full diary support is generated by selected
source leaves and their actual S1/S2 meets. At an index m which is
NOT a source leaf, the support does not change at successor m+1.

Consequently EVERY admissible finite-stage map extends across that
step by literally reusing the same total map; even the extra safe
leaf-image hypothesis is automatic. This is independent of any
reservoir, target genericity, finite flip absorber or relative
realization principle.

Combining this with the verified leaf-determined compatibility bridge
reduces the conditional countable lower bound to relative extension
ONLY at the genuinely new source leaf levels. It does not prove
the latter existence claim.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

namespace AdmissibleCofinalDiaryStage

variable {H K : Ordered3Graph Nat} {F : Nat → Nat}
variable {m : Nat} {f : Nat → Nat}

/-- At a nonleaf source level the SAME total map is admissible
for the next support, with no new choices at all. -/
theorem extend_of_not_leaf
    (P : AdmissibleCofinalDiaryStage H K F m f)
    (hNon : ¬ IsLeaf H m) :
    AdmissibleCofinalDiaryStage H K F (m + 1) f := by
  have hEq := countableDiaryFiniteSupport_succ_of_not_leaf H m hNon
  have hSub (u : Nat)
      (hu : u ∈ countableDiaryFiniteSupport H (m + 1)) :
      u ∈ countableDiaryFiniteSupport H m := by
    simpa only [hEq] using hu
  refine {
    ordered := ?_
    marker_zero := P.marker_zero
    marker_one := P.marker_one
    marker_two := P.marker_two
    leaf_role := ?_
    one_split_role := ?_
    two_split_role := ?_
    induced_edge := ?_
    leaf_oneMeet := ?_
    leaf_twoMeet := ?_
    leaf_range := ?_
  }
  · intro u v hu hv huv
    exact P.ordered u v (hSub u hu) (hSub v hv) huv
  · intro u hu hLeaf
    exact P.leaf_role u (hSub u hu) hLeaf
  · intro u hu hOne
    exact P.one_split_role u (hSub u hu) hOne
  · intro u hu hTwo
    exact P.two_split_role u (hSub u hu) hTwo
  · intro a b c ha hb hc hab hbc
    exact P.induced_edge a b c
      (hSub a ha) (hSub b hb) (hSub c hc) hab hbc
  · intro a b ha hb hLa hLb
    exact P.leaf_oneMeet a b (hSub a ha) (hSub b hb) hLa hLb
  · intro a b c d ha hb hc hd hab hcd hLa hLb hLc hLd
    exact P.leaf_twoMeet a b c d
      (hSub a ha) (hSub b hb) (hSub c hc) (hSub d hd)
      hab hcd hLa hLb hLc hLd
  · intro u hu hLeaf
    exact P.leaf_range u (hSub u hu) hLeaf

/-- The unchanged stage is literally compatible on the entire
old support, not just its leaves. -/
theorem nonleaf_successor_compatible
    (P : AdmissibleCofinalDiaryStage H K F m f)
    (hNon : ¬ IsLeaf H m) :
    ∃ g : Nat → Nat,
      AdmissibleCofinalDiaryStage H K F (m + 1) g ∧
      CofinalDiaryStageCompatible H m f g := by
  exact ⟨f, P.extend_of_not_leaf hNon, by intro u _; rfl⟩

end AdmissibleCofinalDiaryStage

/-- Conditional countable induced lower bound requiring a
relative successor ONLY when the newly enumerated source
vertex is itself a genuine leaf. No extension hypothesis
is necessary at nonleaf levels, even when a split vertex
lies numerically at that level. -/
theorem exists_fullDiaryEmbedding_of_relative_new_leaf_extensions
    {H K : Ordered3Graph Nat} (DH : RoleDiary H)
    (DK : RoleDiary K) (F : Nat → Nat)
    (hNewLeaf : ∀ m : Nat, IsLeaf H m →
      ∀ f : Nat → Nat,
        AdmissibleCofinalDiaryStage H K F m f →
        ∃ g : Nat → Nat,
          AdmissibleCofinalDiaryStage H K F (m + 1) g ∧
          (∀ u : Nat, u ∈ countableDiaryLeafPrefix H m →
            g u = f u)) :
    ∃ e : Ordered3Graph.Embedding H K,
      (∀ u : Nat, IsLeaf H u → ∃ t : Nat, e u = F t) ∧
      (∀ u v : Nat, 3 ≤ u → 3 ≤ v →
        K.oneMeetLevel (e u) (e v) =
          e (H.oneMeetLevel u v)) ∧
      (∀ a b c d : Nat, a < b → c < d →
        3 ≤ a → 3 ≤ c →
        K.twoMeetLevel (e a) (e b) (e c) (e d) =
          e (H.twoMeetLevel a b c d)) := by
  apply exists_fullDiaryEmbedding_of_relative_leaf_extensions DH DK F
  intro m f P
  by_cases hm : IsLeaf H m
  · exact hNewLeaf m hm f P
  · exact ⟨f, P.extend_of_not_leaf hm, by intro u _; rfl⟩

end DiaryLeafPriority
end ThreeUniformDiaries
