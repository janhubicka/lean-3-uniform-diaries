import ThreeUniformDiaries.DiaryFiniteLeafMeetMarkerReindex

/-!
# Genuine leaves in generated finite leaf-meet supports

Every nonmarker vertex of the finite leaf-meet support is either
a selected leaf or a genuine old 1-/2-split. A full pair-meet
generator may be a LEAF only in the capped S2 case, when it
equals the first member of a selected leaf pair. Hence it is
again one of the selected leaves.

We prove the stronger literal equivalence: if L consists of
genuine old leaves, then the leaves of the generated support
are EXACTLY L, even before reindexing. Reindexed finite leaves
likewise correspond exactly to L under the increasing support
enumeration.

In particular, no cap-valued leaf from a pair meet can lie outside L.
This is the input for applying the selected-leaf S1/S2 meet
preservation theorems to ALL finite target leaf pairs, not just
an arbitrary subset of them.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

variable {G : Ordered3Graph Nat} {L : Finset Nat}

/-- A full ordered-pair meet of selected leaves cannot produce an
unselected genuine leaf: the only leaf-valued S2 alternative is
the cap at one of the two selected first coordinates. -/
theorem finiteTwoMeetSupport_leaf_mem_L
    (D : RoleDiary G)
    (hLeaves : ∀ u : Nat, u ∈ L → IsLeaf G u)
    {m : Nat}
    (hm : m ∈ finiteTwoMeetSupport G L)
    (hLeaf : IsLeaf G m) : m ∈ L := by
  classical
  change m ∈
    ((finiteOrderedLeafPairs L).product (finiteOrderedLeafPairs L)).image
      (fun p : (Nat × Nat) × (Nat × Nat) =>
        G.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hm
  obtain ⟨p,hp,hpm⟩ := Finset.mem_image.mp hm
  rcases p with ⟨⟨a,b⟩,⟨c,d⟩⟩
  change G.twoMeetLevel a b c d = m at hpm
  obtain ⟨habP,hcdP⟩ := Finset.mem_product.mp hp
  obtain ⟨habMem,hab⟩ := Finset.mem_filter.mp habP
  obtain ⟨hcdMem,hcd⟩ := Finset.mem_filter.mp hcdP
  obtain ⟨ha,hb⟩ := Finset.mem_product.mp habMem
  obtain ⟨hc,hd⟩ := Finset.mem_product.mp hcdMem
  rcases D.pair_meets a b c d hab hcd
      (hLeaves a ha) (hLeaves b hb)
      (hLeaves c hc) (hLeaves d hd) with hCap | hOne | hTwo
  · have hmCap : m = min a c := hpm.symm.trans hCap
    rcases le_total a c with hac | hca
    · have hEq : m = a := by
        simpa only [min_eq_left hac] using hmCap
      simpa only [hEq] using ha
    · have hEq : m = c := by
        simpa only [min_eq_right hca] using hmCap
      simpa only [hEq] using hc
  · have hEq : m = 1 := hpm.symm.trans hOne
    have hm3 := hLeaf.1
    omega
  · have hSplit : IsTwoSplit G m := by
      rw [← hpm]
      exact hTwo
    exact False.elim (hLeaf.2.2 hSplit.2.2)

/-- Every genuine leaf in the generated finite support was
selected initially. Neither singleton nor full pair meet
generation introduces any new leaf outside L. -/
theorem finiteLeafMeetSupport_leaf_mem_L
    (D : RoleDiary G)
    (hLeaves : ∀ u : Nat, u ∈ L → IsLeaf G u)
    {m : Nat}
    (hm : m ∈ finiteLeafMeetSupport G L)
    (hLeaf : IsLeaf G m) : m ∈ L := by
  change m ∈ (Finset.range 3 ∪ L) ∪
    (finiteOneMeetSupport G L ∪ finiteTwoMeetSupport G L) at hm
  rcases Finset.mem_union.mp hm with hFront | hMeets
  · rcases Finset.mem_union.mp hFront with hMarker | hInL
    · have hmSmall := Finset.mem_range.mp hMarker
      have hm3 := hLeaf.1
      omega
    · exact hInL
  · rcases Finset.mem_union.mp hMeets with hOne | hTwo
    · have hSplit := finiteOneMeetSupport_isOneSplit D hLeaves hOne
      exact False.elim (hLeaf.2.1 hSplit.2.1)
    · exact finiteTwoMeetSupport_leaf_mem_L D hLeaves hTwo hLeaf

/-- In particular, after increasing reindexing of the support,
every finite target leaf is the reindexed image of an ORIGINAL
selected leaf, not a new leaf accidentally generated by S1/S2. -/
theorem finiteLeafMeetSupport_reindexed_leaf_mem_L
    (D : RoleDiary G)
    (hLeaves : ∀ u : Nat, u ∈ L → IsLeaf G u)
    (i : Nat)
    (hi3 : 3 ≤ i)
    (hi : i < (finiteLeafMeetSupport G L).card)
    (hLeaf : IsLeaf (finiteSupportGraph G (finiteLeafMeetSupport G L)) i) :
    finiteSupportIndex (finiteLeafMeetSupport G L) i ∈ L := by
  let S := finiteLeafMeetSupport G L
  have h0 : 0 ∈ S := mem_finiteLeafMeetSupport_marker G L 0 (by omega)
  have h1 : 1 ∈ S := mem_finiteLeafMeetSupport_marker G L 1 (by omega)
  have h2 : 2 ∈ S := mem_finiteLeafMeetSupport_marker G L 2 (by omega)
  have hSourceLeaf : IsLeaf G (finiteSupportIndex S i) :=
    (finiteSupportGraph_leaf_iff
      (G := G) (S := S) h0 h1 h2 i hi3 hi).mp hLeaf
  exact finiteLeafMeetSupport_leaf_mem_L D hLeaves
    (finiteSupportIndex_mem S i hi) hSourceLeaf

end DiaryLeafPriority
end ThreeUniformDiaries
