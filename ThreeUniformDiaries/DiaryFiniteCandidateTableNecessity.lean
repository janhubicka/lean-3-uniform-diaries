import ThreeUniformDiaries.DiaryFiniteGeneratorTable

/-!
# A genuine relative successor makes its finite generator table functional

The generator relation deliberately retains every old marker, selected
leaf, singleton-meet, and full ordered-pair-meet assignment. A real
admissible successor agrees with every one of these entries. In
particular, any conflicting pair of table entries is a finite,
literal obstruction to extending the prescribed old selected leaves.

These results are necessary conditions only: functionality alone
does not assert the induced edge table, order, roles, or the existence
of a target leaf with the required profile.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- A proposed new leaf image v determines the target images
of all selected leaves: old leaf images remain fixed and m maps to v. -/
def candidateLeafImage (f : Nat → Nat) (m v a : Nat) : Nat :=
  if a = m then v else f a

/-- The finite relation of all forced images generated by the
old selected leaf values and a single proposed fresh leaf image. -/
noncomputable def candidateNewLeafGeneratorTable
    (H K : Ordered3Graph Nat)
    (m : Nat) (f : Nat → Nat) (v : Nat) : Finset (Nat × Nat) :=
  finiteLeafGeneratorTable H K
    (countableDiaryLeafPrefix H (m + 1))
    (candidateLeafImage f m v)

/-- A relative successor maps every newly selected source leaf
to its prescribed target value in the finite generator table. -/
theorem relativeSuccessor_selectedLeaf_eq_candidate
    {H : Ordered3Graph Nat} {f g : Nat → Nat} {m v : Nat}
    (hKeep : ∀ a : Nat, a ∈ countableDiaryLeafPrefix H m →
      g a = f a)
    (hNew : g m = v)
    (a : Nat) (ha : a ∈ countableDiaryLeafPrefix H (m + 1)) :
    g a = candidateLeafImage f m v a := by
  by_cases ham : a = m
  · subst a
    simpa [candidateLeafImage] using hNew
  · obtain ⟨ha3,ham1,haLeaf⟩ :=
      (mem_countableDiaryLeafPrefix_iff H (m + 1) a).mp ha
    have haOld : a ∈ countableDiaryLeafPrefix H m :=
      (mem_countableDiaryLeafPrefix_iff H m a).mpr
        ⟨ha3,by omega,haLeaf⟩
    simpa [candidateLeafImage,ham] using hKeep a haOld

namespace AdmissibleCofinalDiaryStage

variable {H K : Ordered3Graph Nat} {F f g : Nat → Nat} {m v : Nat}

/-- Every table entry, including duplicate representations of a
source split, is forced to equal its actual successor image. -/
theorem newLeaf_generator_row_correct
    (Q : AdmissibleCofinalDiaryStage H K F (m + 1) g)
    (hKeep : ∀ a : Nat, a ∈ countableDiaryLeafPrefix H m →
      g a = f a)
    (hNew : g m = v)
    (u w : Nat)
    (hRow : (u,w) ∈ candidateNewLeafGeneratorTable H K m f v) :
    g u = w := by
  classical
  let L := countableDiaryLeafPrefix H (m + 1)
  let q := candidateLeafImage f m v
  have hQ : ∀ a : Nat, a ∈ L → g a = q a := by
    intro a ha
    exact relativeSuccessor_selectedLeaf_eq_candidate
      hKeep hNew a ha
  have hLLeaf : ∀ a : Nat, a ∈ L → IsLeaf H a := by
    intro a ha
    exact ((mem_countableDiaryLeafPrefix_iff H (m + 1) a).mp ha).2.2
  have hLIn : ∀ a : Nat, a ∈ L →
      a ∈ countableDiaryFiniteSupport H (m + 1) := by
    intro a ha
    exact mem_finiteLeafMeetSupport_leaf H L a ha
  change (u,w) ∈ finiteLeafGeneratorTable H K L q at hRow
  unfold finiteLeafGeneratorTable at hRow
  rcases Finset.mem_union.mp hRow with hFront | hMeets
  · rcases Finset.mem_union.mp hFront with hMarker | hLeaf
    · obtain ⟨i,hi,hEq⟩ := Finset.mem_image.mp hMarker
      have hiu : i = u := by simpa using congrArg Prod.fst hEq
      have hiw : i = w := by simpa using congrArg Prod.snd hEq
      have hi3 : i < 3 := Finset.mem_range.mp hi
      have hMarkerImage : g i = i := by
        have hCases : i = 0 ∨ i = 1 ∨ i = 2 := by omega
        rcases hCases with h0 | h1 | h2
        · simpa only [h0] using Q.marker_zero
        · simpa only [h1] using Q.marker_one
        · simpa only [h2] using Q.marker_two
      calc
        g u = g i := congrArg g hiu.symm
        _ = i := hMarkerImage
        _ = w := hiw
    · obtain ⟨a,ha,hEq⟩ := Finset.mem_image.mp hLeaf
      have hau : a = u := by simpa using congrArg Prod.fst hEq
      have haw : q a = w := by simpa using congrArg Prod.snd hEq
      calc
        g u = g a := congrArg g hau.symm
        _ = q a := hQ a ha
        _ = w := haw
  · rcases Finset.mem_union.mp hMeets with hOne | hTwo
    · obtain ⟨⟨a,b⟩,hPair,hEq⟩ := Finset.mem_image.mp hOne
      obtain ⟨hPair,_hne⟩ := Finset.mem_filter.mp hPair
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hPair
      have hu : H.oneMeetLevel a b = u := by
        simpa using congrArg Prod.fst hEq
      have hw : K.oneMeetLevel (q a) (q b) = w := by
        simpa using congrArg Prod.snd hEq
      calc
        g u = g (H.oneMeetLevel a b) := congrArg g hu.symm
        _ = K.oneMeetLevel (g a) (g b) :=
          (Q.leaf_oneMeet a b (hLIn a ha) (hLIn b hb)
            (hLLeaf a ha) (hLLeaf b hb)).symm
        _ = K.oneMeetLevel (q a) (q b) := by
          rw [hQ a ha,hQ b hb]
        _ = w := hw
    · obtain ⟨⟨⟨a,b⟩,⟨c,d⟩⟩,hPair,hEq⟩ :=
        Finset.mem_image.mp hTwo
      obtain ⟨hAB,hCD⟩ := Finset.mem_product.mp hPair
      obtain ⟨hAB,hab⟩ := Finset.mem_filter.mp hAB
      obtain ⟨hCD,hcd⟩ := Finset.mem_filter.mp hCD
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hAB
      obtain ⟨hc,hd⟩ := Finset.mem_product.mp hCD
      have hu : H.twoMeetLevel a b c d = u := by
        simpa using congrArg Prod.fst hEq
      have hw : K.twoMeetLevel (q a) (q b) (q c) (q d) = w := by
        simpa using congrArg Prod.snd hEq
      calc
        g u = g (H.twoMeetLevel a b c d) := congrArg g hu.symm
        _ = K.twoMeetLevel (g a) (g b) (g c) (g d) :=
          (Q.leaf_twoMeet a b c d
            (hLIn a ha) (hLIn b hb)
            (hLIn c hc) (hLIn d hd)
            hab hcd
            (hLLeaf a ha) (hLLeaf b hb)
            (hLLeaf c hc) (hLLeaf d hd)).symm
        _ = K.twoMeetLevel (q a) (q b) (q c) (q d) := by
          rw [hQ a ha,hQ b hb,hQ c hc,hQ d hd]
        _ = w := hw

/-- All generator-value collisions must agree in any valid relative
successor. This condition is a finite necessary obstruction. -/
theorem relative_successor_generator_table_functional
    (Q : AdmissibleCofinalDiaryStage H K F (m + 1) g)
    (hKeep : ∀ a : Nat, a ∈ countableDiaryLeafPrefix H m →
      g a = f a)
    (hNew : g m = v) :
    FiniteGeneratorTableFunctional
      (candidateNewLeafGeneratorTable H K m f v) := by
  intro u w₁ w₂ h₁ h₂
  calc
    w₁ = g u := (Q.newLeaf_generator_row_correct hKeep hNew u w₁ h₁).symm
    _ = w₂ := Q.newLeaf_generator_row_correct hKeep hNew u w₂ h₂

/-- Once a valid successor exists, evaluating the finite table
recovers its actual image on every vertex of the new support. -/
theorem relative_successor_agrees_with_table
    (Q : AdmissibleCofinalDiaryStage H K F (m + 1) g)
    (hKeep : ∀ a : Nat, a ∈ countableDiaryLeafPrefix H m →
      g a = f a)
    (hNew : g m = v)
    (u : Nat) (hu : u ∈ countableDiaryFiniteSupport H (m + 1)) :
    finiteGeneratorTableValue
      (candidateNewLeafGeneratorTable H K m f v) u = g u := by
  let L := countableDiaryLeafPrefix H (m + 1)
  obtain ⟨w,hRow⟩ :=
    finiteLeafGeneratorTable_covers_support
      H K L (candidateLeafImage f m v) u hu
  have hFunction :=
    Q.relative_successor_generator_table_functional hKeep hNew
  calc
    finiteGeneratorTableValue
      (candidateNewLeafGeneratorTable H K m f v) u = w :=
        finiteGeneratorTableValue_eq_of_mem
          _ hFunction u w hRow
    _ = g u := (Q.newLeaf_generator_row_correct hKeep hNew u w hRow).symm

/-- Failure of the finite table functionality test rules out
the proposed new-leaf image v, even before checking target edge
incidences, ordering or split roles. -/
theorem no_relative_successor_of_nonfunctional_table
    (hBad : ¬ FiniteGeneratorTableFunctional
      (candidateNewLeafGeneratorTable H K m f v)) :
    ¬ ∃ g : Nat → Nat,
      AdmissibleCofinalDiaryStage H K F (m + 1) g ∧
      (∀ a : Nat, a ∈ countableDiaryLeafPrefix H m →
        g a = f a) ∧ g m = v := by
  rintro ⟨g,Q,hKeep,hNew⟩
  exact hBad (Q.relative_successor_generator_table_functional hKeep hNew)

end AdmissibleCofinalDiaryStage
end DiaryLeafPriority
end ThreeUniformDiaries
