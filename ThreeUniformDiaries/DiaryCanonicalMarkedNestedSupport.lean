import ThreeUniformDiaries.DiaryCanonicalMarkedNestedTwoSupport

/-!
# Nested finite canonical marked diary: exact generated vertex sets

The complete set of markers, selected leaves, singleton S1
generators and full ordered-pair S2 generators after the first
finite canonical reindexing is EXACTLY the rank-image of
the original finite support generated by the smaller leaf set.

This proves the SET equality underlying the appendix's nested
support lemma, without yet identifying the canonical SECOND
reindexing's full induced graph table and marked coordinates.
Both those final pieces are separate Lean obligations.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

theorem finiteLeafMeetSupport_nested_rank_image
    {K : Ordered3Graph Nat}
    (D : RoleDiary K)
    (L L' : Finset Nat)
    (hLeaves : ∀ u : Nat, u ∈ L → IsLeaf K u)
    (hSub : L' ⊆ L) :
    (finiteLeafMeetSupport K L').image
        (finiteSupportRank (finiteLeafMeetSupport K L)) =
      finiteLeafMeetSupport
        (finiteSupportGraph K (finiteLeafMeetSupport K L))
        (L'.image (finiteSupportRank (finiteLeafMeetSupport K L))) := by
  classical
  let S : Finset Nat := finiteLeafMeetSupport K L
  let H : Ordered3Graph Nat := finiteSupportGraph K S
  let r : Nat → Nat := finiteSupportRank S
  have h0 : 0 ∈ S := mem_finiteLeafMeetSupport_marker K L 0 (by omega)
  have h1 : 1 ∈ S := mem_finiteLeafMeetSupport_marker K L 1 (by omega)
  have h2 : 2 ∈ S := mem_finiteLeafMeetSupport_marker K L 2 (by omega)
  have hMarkers := finiteSupportRank_marker S h0 h1 h2
  have hFix (x : Nat) (hx : x < 3) : r x = x := by
    have hCases : x = 0 ∨ x = 1 ∨ x = 2 := by omega
    rcases hCases with rfl | rfl | rfl
    · exact hMarkers.1
    · exact hMarkers.2.1
    · exact hMarkers.2.2
  have hImageMarkers : (Finset.range 3).image r = Finset.range 3 := by
    apply Finset.ext
    intro x
    constructor
    · intro hx
      obtain ⟨u,hu,heq⟩ := Finset.mem_image.mp hx
      have hu3 := Finset.mem_range.mp hu
      rw [hFix u hu3] at heq
      simpa only [← heq] using hu
    · intro hx
      exact Finset.mem_image.mpr
        ⟨x,hx,hFix x (Finset.mem_range.mp hx)⟩
  have hOne := finiteOneMeetSupport_nested_rank_image
    D L L' hLeaves hSub
  have hTwo := finiteTwoMeetSupport_nested_rank_image
    D L L' hLeaves hSub
  change (((Finset.range 3 ∪ L') ∪
      (finiteOneMeetSupport K L' ∪ finiteTwoMeetSupport K L')).image r) =
    ((Finset.range 3 ∪ L'.image r) ∪
      (finiteOneMeetSupport H (L'.image r) ∪
       finiteTwoMeetSupport H (L'.image r)))
  simp only [Finset.image_union, hImageMarkers, hOne, hTwo]

end DiaryLeafPriority
end ThreeUniformDiaries
