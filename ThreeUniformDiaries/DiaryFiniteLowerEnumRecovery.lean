import ThreeUniformDiaries.DiaryFiniteLowerCanonicalSupport
import ThreeUniformDiaries.DiaryUpperBoundFiniteFrameZeroExtension

/-!
# Track C lower bridge: literal finite EnumNode recovery under full meet embeddings

A full finite diary source is encoded as an EnumNode n with no
out-of-range edge bits. Its genuine finite meet-preserving image
inside a countable full diary generates exactly the image of
the entire n-vertex source interval (merged #986). Track C's
canonical support transport (stacked PR #1073) states that sorting
this image preserves the source indexing and full induced
edge/nonedge table.

Here we convert that stronger relational statement into literal
equality of finite EnumNode tables. This matters for a LOWER-bound
canonical diary-colouring: its value must be the EXACT original
finite diary source/marking, not an unspecified isomorphic graph.

The resulting lemma assumes an ACTUAL finite meet embedding.
It is not itself an unconditional lower big Ramsey degree theorem
or an alternative proof of the existing finite unavoidability
theorem; those are separate inputs.
-/

namespace ThreeUniformDiaries

namespace EnumNode

/-- A genuinely finite ordered hypergraph A is exactly the
initial segment of its own canonical zero-extended edge
predicate. Neither a synthetic nonzero source tail nor a
choice of finite graph is involved. -/
theorem initialSegment_toOrdered3Graph_self
    {n : Nat} (A : EnumNode n) :
    A.toOrdered3Graph.initialSegment n = A := by
  classical
  apply EnumNode.ext_triples
  funext i j k
  change decide
    (i < j ∧ j < k ∧ k < n ∧ A.triple i j k = true) =
      A.triple i j k
  cases h : A.triple i j k with
  | false =>
      simp [h]
  | true =>
      have hValid : i < j ∧ j < k ∧ k < n := by
        by_contra hn
        have hZero := A.support i j k hn
        simp only [h] at hZero
        cases hZero
      simp [h, hValid]

end EnumNode

namespace DiaryLeafPriority

open Ordered3Graph

/-- The full n-vertex EnumNode induced on the canonical target
support generated by a finite meet embedding's leaf images
is literally the source n-vertex EnumNode. Edge AND nonedge
reflection is used, and no arbitrary numbering is permitted. -/
theorem FiniteMeetEmbedding.canonical_leafSupport_enum_eq
    {H T : Ordered3Graph Nat} {n : Nat} {f : Nat → Nat}
    (D : FiniteRoleDiaryBlock H n)
    (E : FiniteMeetEmbedding H T n f)
    (L : Finset Nat)
    (hL : ∀ u : Nat, u ∈ L ↔
      3 ≤ u ∧ u < n ∧ IsLeaf H u) :
    (finiteSupportGraph T
      (finiteLeafMeetSupport T (L.image f))).initialSegment n =
      H.initialSegment n := by
  classical
  apply EnumNode.ext_triples
  funext a b c
  change decide
      (a < b ∧ b < c ∧ c < n ∧
        (finiteSupportGraph T
          (finiteLeafMeetSupport T (L.image f))).edge a b c) =
    decide (a < b ∧ b < c ∧ c < n ∧ H.edge a b c)
  have hIff :
      (a < b ∧ b < c ∧ c < n ∧
        (finiteSupportGraph T
          (finiteLeafMeetSupport T (L.image f))).edge a b c) ↔
      (a < b ∧ b < c ∧ c < n ∧ H.edge a b c) := by
    constructor
    · rintro ⟨hab,hbc,hcn,he⟩
      exact ⟨hab,hbc,hcn,
        (E.canonical_leafSupport_edge_iff
          D L hL a b c hab hbc hcn).mp he⟩
    · rintro ⟨hab,hbc,hcn,he⟩
      exact ⟨hab,hbc,hcn,
        (E.canonical_leafSupport_edge_iff
          D L hL a b c hab hbc hcn).mpr he⟩
  exact congrArg (fun p : Prop => decide p) (propext hIff)

/-- For a genuine finite source represented by EnumNode n,
the canonical extracted source picture of its meet-preserving
target image is not just an isomorphic diagram: it is EXACTLY
the original EnumNode n, as a literal type-level equality. -/
theorem FiniteMeetEmbedding.canonical_leafSupport_sourcePicture_eq
    {n : Nat} (A : EnumNode n)
    {T : Ordered3Graph Nat} {f : Nat → Nat}
    (D : FiniteRoleDiaryBlock A.toOrdered3Graph n)
    (E : FiniteMeetEmbedding A.toOrdered3Graph T n f)
    (L : Finset Nat)
    (hL : ∀ u : Nat, u ∈ L ↔
      3 ≤ u ∧ u < n ∧ IsLeaf A.toOrdered3Graph u) :
    (finiteSupportGraph T
      (finiteLeafMeetSupport T (L.image f))).initialSegment n = A := by
  calc
    (finiteSupportGraph T
      (finiteLeafMeetSupport T (L.image f))).initialSegment n =
        A.toOrdered3Graph.initialSegment n :=
      E.canonical_leafSupport_enum_eq D L hL
    _ = A := A.initialSegment_toOrdered3Graph_self

end DiaryLeafPriority
end ThreeUniformDiaries
