import ThreeUniformDiaries.DiaryCofinalStageRestrictions
import ThreeUniformDiaries.DiaryCountableRelativeMarkerBase

/-!
# Leaf images force every split image on a canonical finite diary support

The exact finite support S_m is generated by:
  0,1,2; its selected genuine leaves L_m;
  all one-meets of distinct selected leaves;
  all full two-meets of ordered selected leaf pairs.

Any admissible stage map must preserve the two kinds of leaf meets
literally. Consequently TWO admissible maps on the same support are
equal there if they agree only on the SELECTED LEAVES. Images of the
one-splits and two-splits are not independent choices.

This yields a useful strengthening of the relative extension gate:
preserve only the old source LEAVES when choosing the next admissible
stage. Literal equality on ALL old split images follows automatically.

The lemma neither constructs new admissible stages nor proves that
old leaf images can actually be extended inside the prescribed range.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

namespace AdmissibleCofinalDiaryStage

variable {H K : Ordered3Graph Nat} {F : Nat → Nat}
variable {m : Nat} {f g : Nat → Nat}

/-- Two admissible stage maps with identical selected-leaf
images agree on their entire finite leaf-meet support. -/
theorem eq_on_support_of_selected_leaves
    (P : AdmissibleCofinalDiaryStage H K F m f)
    (Q : AdmissibleCofinalDiaryStage H K F m g)
    (hLeaves : ∀ u : Nat, u ∈ countableDiaryLeafPrefix H m →
      f u = g u) :
    ∀ u : Nat, u ∈ countableDiaryFiniteSupport H m →
      f u = g u := by
  classical
  let L := countableDiaryLeafPrefix H m
  have hLLeaf : ∀ z : Nat, z ∈ L → IsLeaf H z := by
    intro z hz
    exact ((mem_countableDiaryLeafPrefix_iff H m z).mp hz).2.2
  have hInSupport : ∀ z : Nat, z ∈ L →
      z ∈ countableDiaryFiniteSupport H m := by
    intro z hz
    exact mem_finiteLeafMeetSupport_leaf H L z hz
  intro u hu
  change u ∈ (Finset.range 3 ∪ L) ∪
    (finiteOneMeetSupport H L ∪ finiteTwoMeetSupport H L) at hu
  rcases Finset.mem_union.mp hu with hFront | hMeet
  · rcases Finset.mem_union.mp hFront with hMarker | hLeaf
    · have huSmall : u < 3 := Finset.mem_range.mp hMarker
      have hCases : u = 0 ∨ u = 1 ∨ u = 2 := by omega
      rcases hCases with h0 | h1 | h2
      · subst u
        exact P.marker_zero.trans Q.marker_zero.symm
      · subst u
        exact P.marker_one.trans Q.marker_one.symm
      · subst u
        exact P.marker_two.trans Q.marker_two.symm
    · exact hLeaves u hLeaf
  · rcases Finset.mem_union.mp hMeet with hOne | hTwo
    · change u ∈ ((L.product L).filter
        (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => H.oneMeetLevel p.1 p.2) at hOne
      obtain ⟨⟨a,b⟩,hPair,hEq⟩ := Finset.mem_image.mp hOne
      obtain ⟨hPair,_hNe⟩ := Finset.mem_filter.mp hPair
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hPair
      have hA := hInSupport a ha
      have hB := hInSupport b hb
      have hLA := hLLeaf a ha
      have hLB := hLLeaf b hb
      calc
        f u = f (H.oneMeetLevel a b) := congrArg f hEq.symm
        _ = K.oneMeetLevel (f a) (f b) :=
          (P.leaf_oneMeet a b hA hB hLA hLB).symm
        _ = K.oneMeetLevel (g a) (g b) := by
          rw [hLeaves a ha, hLeaves b hb]
        _ = g (H.oneMeetLevel a b) :=
          Q.leaf_oneMeet a b hA hB hLA hLB
        _ = g u := congrArg g hEq
    · change u ∈
        ((finiteOrderedLeafPairs L).product
          (finiteOrderedLeafPairs L)).image
          (fun p : (Nat × Nat) × (Nat × Nat) =>
            H.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hTwo
      obtain ⟨⟨⟨a,b⟩,⟨c,d⟩⟩,hp,hEq⟩ :=
        Finset.mem_image.mp hTwo
      obtain ⟨hAB,hCD⟩ := Finset.mem_product.mp hp
      obtain ⟨hAB,hab⟩ := Finset.mem_filter.mp hAB
      obtain ⟨hCD,hcd⟩ := Finset.mem_filter.mp hCD
      obtain ⟨ha,hb⟩ := Finset.mem_product.mp hAB
      obtain ⟨hc,hd⟩ := Finset.mem_product.mp hCD
      have hA := hInSupport a ha
      have hB := hInSupport b hb
      have hC := hInSupport c hc
      have hD := hInSupport d hd
      have hLA := hLLeaf a ha
      have hLB := hLLeaf b hb
      have hLC := hLLeaf c hc
      have hLD := hLLeaf d hd
      calc
        f u = f (H.twoMeetLevel a b c d) := congrArg f hEq.symm
        _ = K.twoMeetLevel (f a) (f b) (f c) (f d) :=
          (P.leaf_twoMeet a b c d
            hA hB hC hD hab hcd hLA hLB hLC hLD).symm
        _ = K.twoMeetLevel (g a) (g b) (g c) (g d) := by
          rw [hLeaves a ha, hLeaves b hb,
            hLeaves c hc, hLeaves d hd]
        _ = g (H.twoMeetLevel a b c d) :=
          Q.leaf_twoMeet a b c d
            hA hB hC hD hab hcd hLA hLB hLC hLD
        _ = g u := congrArg g hEq

/-- To extend an admissible stage, it is enough to KEEP the
images of its selected leaves. Marker and split images then
remain fixed on the whole previous support automatically. -/
theorem successor_compatible_of_selected_leaf_agreement
    {m : Nat} {f g : Nat → Nat}
    (P : AdmissibleCofinalDiaryStage H K F m f)
    (Q : AdmissibleCofinalDiaryStage H K F (m + 1) g)
    (hLeaves : ∀ u : Nat, u ∈ countableDiaryLeafPrefix H m →
      g u = f u) :
    CofinalDiaryStageCompatible H m f g := by
  have Qm : AdmissibleCofinalDiaryStage H K F m g :=
    Q.restrict (Nat.le_succ m)
  intro u hu
  exact (P.eq_on_support_of_selected_leaves Qm
    (fun z hz => (hLeaves z hz).symm) u hu).symm

end AdmissibleCofinalDiaryStage

/-- Relative extension of old LEAF images alone suffices for
the same full countable induced diary embedding as the much
stronger-looking old-SUPPORT-preserving hypothesis. -/
theorem exists_fullDiaryEmbedding_of_relative_leaf_extensions
    {H K : Ordered3Graph Nat} (DH : RoleDiary H)
    (DK : RoleDiary K) (F : Nat → Nat)
    (hExtendLeaf : ∀ m : Nat, ∀ f : Nat → Nat,
      AdmissibleCofinalDiaryStage H K F m f →
      ∃ g : Nat → Nat,
        AdmissibleCofinalDiaryStage H K F (m + 1) g ∧
        (∀ u : Nat, u ∈ countableDiaryLeafPrefix H m →
          g u = f u)) :
    ∃ e : Ordered3Graph.Embedding H K,
      (∀ u : Nat, IsLeaf H u → ∃ t : Nat, e u = F t) ∧
      (∀ u v : Nat, 3 ≤ u → 3 ≤ v →
        K.oneMeetLevel (e u) (e v) =
          e (H.oneMeetLevel u v)) ∧
      (∀ a b c d : Nat, a < b → c < d →
        3 ≤ a → 3 ≤ c →
        K.twoMeetLevel (e a) (e b) (e c) (e d) =
          e (H.twoMeetLevel a b c d)) := by
  apply exists_fullDiaryEmbedding_of_relative_extension DH DK F
  intro m f P
  obtain ⟨g,Q,hLeaf⟩ := hExtendLeaf m f P
  exact ⟨g,Q,P.successor_compatible_of_selected_leaf_agreement Q hLeaf⟩

end DiaryLeafPriority
end ThreeUniformDiaries
