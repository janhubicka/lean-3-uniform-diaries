import ThreeUniformDiaries.DiaryFiniteLeafMeetRoleSupport
import ThreeUniformDiaries.DiaryOneNewLeafSupportSuccessor
import ThreeUniformDiaries.TwoTypeMeetLevel

/-!
# Two selected source leaves do not generate a two-split

The leaf-meet support of two genuine source leaves a<b may contain
a one-split at the singleton meet of a and b, but it cannot contain
a genuine two-split. There is only ONE ordered leaf pair (a,b);
the full meet of that pair with itself is its first leaf a,
not a two-split.

This is a genuine local simplification for the second selected
leaf stage in countable diary fusion. It neither constructs a
target leaf nor proves relative extendibility from genericity.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- Reflexivity of the full two-type relation shows that any
ordered pair meets itself at its first coordinate (the cap).
No diary axioms are needed. -/
theorem twoMeetLevel_self_pair
    (H : Ordered3Graph Nat) (a b : Nat) :
    H.twoMeetLevel a b a b = a := by
  classical
  have hLe : H.twoMeetLevel a b a b ≤ a := by
    have h := H.twoMeetLevel_le_min a b a b
    simpa only [min_self] using h
  have hAgree : H.SameTwoTypeBelow a a b a b := by
    constructor
    · intro x y hxy hya
      rfl
    · constructor
      · intro x y hxy hya
        rfl
      · intro x hxa
        rfl
  have hGe : a ≤ H.twoMeetLevel a b a b := by
    unfold Ordered3Graph.twoMeetLevel
    apply Nat.le_findGreatest (by simp)
    exact hAgree
  omega

/-- The genuine full diary support generated by exactly two
distinct selected leaves has no vertex with the two-split role.
The sole full ordered-pair meet is the capped leaf coordinate. -/
theorem RoleDiary.no_twoSplit_in_twoLeafMeetSupport
    {H : Ordered3Graph Nat} (D : RoleDiary H)
    (a b : Nat) (ha : IsLeaf H a) (hb : IsLeaf H b)
    (hab : a < b)
    (s : Nat)
    (hs : s ∈ finiteLeafMeetSupport H ({a,b} : Finset Nat)) :
    ¬ IsTwoSplit H s := by
  classical
  intro hTwo
  have hLeaves : ∀ u : Nat, u ∈ ({a,b} : Finset Nat) →
      IsLeaf H u := by
    intro u hu
    have hu : u = a ∨ u = b := by
      simpa only [Finset.mem_insert, Finset.mem_singleton] using hu
    rcases hu with rfl | rfl
    · exact ha
    · exact hb
  obtain ⟨x,y,u,v,hx,hy,hu,hv,hxy,huv,hMeet⟩ :=
    finiteLeafMeetSupport_twoSplit_selected_witness
      D hLeaves hs hTwo
  have hxCases : x = a ∨ x = b := by
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hx
  have hyCases : y = a ∨ y = b := by
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hy
  have huCases : u = a ∨ u = b := by
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hu
  have hvCases : v = a ∨ v = b := by
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hv
  have hxA : x = a := by omega
  have hyB : y = b := by omega
  have huA : u = a := by omega
  have hvB : v = b := by omega
  have hMeet' : H.twoMeetLevel a b a b = s := by
    simpa only [hxA, hyB, huA, hvB] using hMeet
  have hsA : a = s :=
    (twoMeetLevel_self_pair H a b).symm.trans hMeet'
  subst s
  exact ha.2.2 hTwo.2.2

/-- For the second genuine source leaf, its newly generated
support is still two-split-free: both selected leaf levels and
any newly generated singleton meet are all its nonmarker data. -/
theorem RoleDiary.second_leaf_support_no_twoSplit
    {H : Ordered3Graph Nat} (D : RoleDiary H)
    {a m : Nat}
    (ha : IsLeaf H a) (hm : IsLeaf H m)
    (ham : a < m)
    (hOld : countableDiaryLeafPrefix H m = {a})
    (s : Nat) (hs : s ∈ countableDiaryFiniteSupport H (m + 1)) :
    ¬ IsTwoSplit H s := by
  have hNew : countableDiaryLeafPrefix H (m + 1) =
      ({a,m} : Finset Nat) := by
    rw [countableDiaryLeafPrefix_succ_of_leaf H m hm, hOld]
    simp only [Finset.insert_comm]
  change s ∈ finiteLeafMeetSupport H
    (countableDiaryLeafPrefix H (m + 1)) at hs
  rw [hNew] at hs
  exact D.no_twoSplit_in_twoLeafMeetSupport a m ha hm ham s hs

end DiaryLeafPriority
end ThreeUniformDiaries
