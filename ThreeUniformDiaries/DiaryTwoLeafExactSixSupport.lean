import ThreeUniformDiaries.DiaryTwoLeafSupportNoTwoSplit
import ThreeUniformDiaries.DiaryFiniteLeafMeetOnlySelectedLeaves

/-!
# Exact six-vertex support for two genuine selected diary leaves

The previously verified no-two-split theorem excludes genuine
two-split vertices from the support of exactly two selected leaves.
Here we prove the sharper literal set equality: the support consists
of precisely the three markers, the two selected leaves, and their
ONE singleton meet.

In particular there cannot be two different singleton meet vertices
generated by swapping the ordered pair of leaves: the numerical
one-type meet itself is symmetric. Its symmetry is proven directly
from the defining maximal initial-type agreement predicate.

This is a finite structural result. It does not construct a suitable
new target leaf, preserve mixed E2/V3 orientation, or prove countable
unavoidability.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- Numerical singleton type meets are symmetric in any ordered
three-graph, even before imposing diary V/E/S constraints. -/
theorem oneMeetLevel_comm
    (H : Ordered3Graph Nat) (a b : Nat) :
    H.oneMeetLevel a b = H.oneMeetLevel b a := by
  have habBound : H.oneMeetLevel a b ≤ min b a := by
    simpa only [min_comm] using H.oneMeetLevel_le_min a b
  have hbaBound : H.oneMeetLevel b a ≤ min a b := by
    simpa only [min_comm] using H.oneMeetLevel_le_min b a
  have hAB : H.SameOneTypeBelow (H.oneMeetLevel a b) b a := by
    intro x y hxy hyl
    exact (H.oneMeetLevel_agree a b hxy hyl).symm
  have hBA : H.SameOneTypeBelow (H.oneMeetLevel b a) a b := by
    intro x y hxy hyl
    exact (H.oneMeetLevel_agree b a hxy hyl).symm
  have hLe : H.oneMeetLevel a b ≤ H.oneMeetLevel b a := by
    change H.oneMeetLevel a b ≤
      Nat.findGreatest (fun l => H.SameOneTypeBelow l b a) (min b a)
    exact Nat.le_findGreatest habBound hAB
  have hGe : H.oneMeetLevel b a ≤ H.oneMeetLevel a b := by
    change H.oneMeetLevel b a ≤
      Nat.findGreatest (fun l => H.SameOneTypeBelow l a b) (min a b)
    exact Nat.le_findGreatest hbaBound hBA
  omega

/-- For a genuine full source diary, precisely six role vertices
are generated by any two distinct selected leaves a<b:
markers 0,1,2; the singleton meet s=a meet b; and a,b.
The S2 full pair-meet of the unique ordered pair (a,b) with
itself contributes only the leaf a, by the already verified
full pair self-cap theorem. -/
theorem RoleDiary.twoLeafSupport_eq
    {H : Ordered3Graph Nat} (D : RoleDiary H)
    (a b : Nat) (ha : IsLeaf H a) (hb : IsLeaf H b)
    (hab : a < b) :
    finiteLeafMeetSupport H ({a,b} : Finset Nat) =
      (Finset.range 3 ∪
        ({a,b,H.oneMeetLevel a b} : Finset Nat)) := by
  classical
  let L : Finset Nat := {a,b}
  have hLeaves : ∀ u : Nat, u ∈ L → IsLeaf H u := by
    intro u hu
    have hc : u = a ∨ u = b := by
      simpa only [L, Finset.mem_insert, Finset.mem_singleton] using hu
    rcases hc with rfl | rfl
    · exact ha
    · exact hb
  have hLeafA : a ∈ L := by simp [L]
  have hLeafB : b ∈ L := by simp [L]
  ext s
  constructor
  · intro hs
    rcases finiteLeafMeetSupport_role D hLeaves hs with
      hMark | hLeaf | hOne | hTwo
    · exact Finset.mem_union.mpr
        (Or.inl (Finset.mem_range.mpr hMark))
    · have hsL : s ∈ L :=
        finiteLeafMeetSupport_leaf_mem_L D hLeaves hs hLeaf
      have hc : s = a ∨ s = b := by
        simpa only [L, Finset.mem_insert, Finset.mem_singleton] using hsL
      rcases hc with hA | hB
      · subst s
        simp
      · subst s
        simp
    · obtain ⟨u,v,hu,hv,huv,hMeet⟩ :=
        finiteLeafMeetSupport_oneSplit_selected_witness
          D hLeaves hs hOne
      have huCases : u = a ∨ u = b := by
        simpa only [L, Finset.mem_insert, Finset.mem_singleton] using hu
      have hvCases : v = a ∨ v = b := by
        simpa only [L, Finset.mem_insert, Finset.mem_singleton] using hv
      rcases huCases with huA | huB
      · rcases hvCases with hvA | hvB
        · exact False.elim (huv (huA.trans hvA.symm))
        · have hS : H.oneMeetLevel a b = s := by
            simpa only [huA,hvB] using hMeet
          rw [← hS]
          simp
      · rcases hvCases with hvA | hvB
        · have hS : H.oneMeetLevel b a = s := by
            simpa only [huB,hvA] using hMeet
          have hS' : H.oneMeetLevel a b = s :=
            (oneMeetLevel_comm H a b).trans hS
          rw [← hS']
          simp
        · exact False.elim (huv (huB.trans hvB.symm))
    · exact False.elim
        ((D.no_twoSplit_in_twoLeafMeetSupport a b ha hb hab s hs) hTwo)
  · intro hs
    have hCases : s < 3 ∨ s = a ∨ s = b ∨
        s = H.oneMeetLevel a b := by
      simpa only [Finset.mem_union, Finset.mem_range,
        Finset.mem_insert, Finset.mem_singleton] using hs
    rcases hCases with hMark | hA | hB | hMeet
    · exact mem_finiteLeafMeetSupport_marker H L s hMark
    · subst s
      exact mem_finiteLeafMeetSupport_leaf H L a hLeafA
    · subst s
      exact mem_finiteLeafMeetSupport_leaf H L b hLeafB
    · subst s
      exact mem_finiteLeafMeetSupport_oneMeet H L
        a b hLeafA hLeafB (ne_of_lt hab)

/-- If a<m are exactly the first two selected source leaves,
the canonical successor support is the same literal six-point
set, with its exact source coordinate positions. -/
theorem RoleDiary.second_leaf_support_eq_six
    {H : Ordered3Graph Nat} (D : RoleDiary H)
    {a m : Nat}
    (ha : IsLeaf H a) (hm : IsLeaf H m)
    (ham : a < m)
    (hOld : countableDiaryLeafPrefix H m = {a}) :
    countableDiaryFiniteSupport H (m + 1) =
      (Finset.range 3 ∪
        ({a,m,H.oneMeetLevel a m} : Finset Nat)) := by
  have hNew :
      countableDiaryLeafPrefix H (m + 1) =
        ({a,m} : Finset Nat) := by
    rw [countableDiaryLeafPrefix_succ_of_leaf H m hm, hOld]
    ext u
    simp only [Finset.mem_insert, Finset.mem_singleton]
    tauto
  change finiteLeafMeetSupport H
    (countableDiaryLeafPrefix H (m + 1)) =
    Finset.range 3 ∪ {a,m,H.oneMeetLevel a m}
  rw [hNew]
  exact D.twoLeafSupport_eq a m ha hm ham

end DiaryLeafPriority
end ThreeUniformDiaries
