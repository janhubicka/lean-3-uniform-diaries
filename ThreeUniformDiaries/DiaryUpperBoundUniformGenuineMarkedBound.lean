import ThreeUniformDiaries.DiaryUpperBoundGenuineMarkedFamily
import ThreeUniformDiaries.DiaryFiniteExactImageSupport
import ThreeUniformDiaries.DiaryFiniteSupportCardinality

/-!
# Track A: the full genuine marked diary type family is finite WITHOUT a cutoff

A finite full diary with exactly a distinct marked leaves is
*already* generated by its leaf-meet support. This follows from
the V1/V2 witness requirements of FiniteRoleDiaryBlock and the
existing exact finite range/support theorem, applied to the
identity finite meet embedding.

Consequently every genuine marked diary source with a marked
labelled copy of size a has at most
  3 + a + a*a + (a*a)*(a*a)
genuine vertices. This bound is independent of the target
countable diary, source embedding, and arbitrary colourings.

We can therefore use a single finite, deduplicated list of ALL
genuine marked diary shapes of A, without stipulating a
size cutoff in the eventual upper-bound statement.

This does not identify that list's length with the *published*
diary-count times |Aut(A)|. That identification is still a
separate precise finite counting obligation.
-/

namespace ThreeUniformDiaries
namespace ATRFiniteDecoder

open Ordered3Graph
open DiaryLeafPriority

/-- Uniform, deliberately coarse support-size bound for a labelled
A with a genuine vertex set of size a. -/
def uniformMarkedDiaryBound (a : Nat) : Nat :=
  3 + a + a * a + (a * a) * (a * a)

/-- The identity on a finite full diary's literal initial frame
is a finite induced all-numerical-meet embedding. In particular
no ambient infinity or chosen continuation is involved. -/
def finiteMeetEmbeddingIdentity
    (H : Ordered3Graph Nat) (m : Nat) :
    FiniteMeetEmbedding H H m (fun u => u) := {
  strictMono := by intro i j hij; exact hij
  marker_zero := rfl
  marker_one := rfl
  marker_two := rfl
  edge_iff := by intros; exact Iff.rfl
  leaf_iff := by intros; exact Iff.rfl
  oneSplit_iff := by intros; exact Iff.rfl
  twoSplit_iff := by intros; exact Iff.rfl
  oneMeet := by intros; rfl
  twoMeet := by intros; rfl
}

/-- The source size of a genuine marked diary is uniformly bounded
by the marked leaf count alone. The key step is that every source
split is a witness meet of true bounded leaves, so the entire
source frame is exactly its generated leaf-meet support. -/
theorem genuineMarkedDiaryShape_size_le
    {a : Nat} (A : EnumNode a)
    (S : MarkedFiniteSource 0 a)
    (hShape : IsGenuineMarkedDiaryShape A S) :
    S.source.k + 1 ≤ uniformMarkedDiaryBound a := by
  classical
  let H : Ordered3Graph Nat := S.source.picture.toOrdered3Graph
  let m : Nat := S.source.k + 1
  let L : Finset Nat :=
    (Finset.univ : Finset (Fin a)).image
      (fun i => (S.marked i).val)
  dsimp [IsGenuineMarkedDiaryShape] at hShape
  rcases hShape with ⟨D, _hCopy, hMarked, hCovered⟩
  have hL : ∀ u : Nat, u ∈ L ↔
      3 ≤ u ∧ u < m ∧ IsLeaf H u := by
    intro u
    constructor
    · intro hu
      obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hu
      exact ⟨(hMarked i).1, (S.marked i).isLt, hMarked i⟩
    · rintro ⟨hu3,hum,huLeaf⟩
      obtain ⟨i,heq⟩ := hCovered u hu3 hum huLeaf
      exact Finset.mem_image.mpr
        ⟨i, Finset.mem_univ i, heq⟩
  have hSupport : Finset.range m = finiteLeafMeetSupport H L := by
    have hFull :=
      (finiteMeetEmbeddingIdentity H m).range_eq_image_leafMeetSupport
        D D.prediary.frame.length_ge_three L hL
    have hIdentityImage (U : Finset Nat) :
        U.image (fun u : Nat => u) = U := by
      classical
      ext x
      simp
    simpa only [hIdentityImage] using hFull
  have hCard : L.card ≤ a := by
    calc
      L.card ≤ (Finset.univ : Finset (Fin a)).card :=
        Finset.card_image_le
      _ = a := by simp
  have hPoly := finiteLeafMeetSupport_card_le_of_card_le
    H L a hCard
  have hSize : m = (finiteLeafMeetSupport H L).card := by
    have h := congrArg Finset.card hSupport
    simpa using h
  change m ≤ uniformMarkedDiaryBound a
  rw [hSize]
  exact hPoly

/-- One canonical finite list of *all* marked genuine finite
diaries of A, no extraneous bound parameter. -/
noncomputable def allGenuineMarkedDiaryShapes
    {a : Nat} (A : EnumNode a) :
    List (MarkedFiniteSource 0 a) :=
  genuineMarkedDiaryFamily A (uniformMarkedDiaryBound a)

/-- Membership in the finite list is EQUIVALENT to having the
genuine full diary axioms and a labelled induced A-copy whose
image is exactly the leaf set. There are no omitted large
shapes or spurious raw finite hypergraphs. -/
theorem mem_allGenuineMarkedDiaryShapes_iff
    {a : Nat} (A : EnumNode a)
    (S : MarkedFiniteSource 0 a) :
    S ∈ allGenuineMarkedDiaryShapes A ↔
      IsGenuineMarkedDiaryShape A S := by
  change S ∈ genuineMarkedDiaryFamily A
      (uniformMarkedDiaryBound a) ↔
      IsGenuineMarkedDiaryShape A S
  rw [mem_genuineMarkedDiaryFamily]
  constructor
  · exact And.right
  · intro h
    exact ⟨genuineMarkedDiaryShape_size_le A S h, h⟩

/-- A target-independent finite cardinal for the set of all
genuine labelled diary types. Equality with the manuscript's
unlabelled diary count times |Aut(A)| is left separate. -/
noncomputable def allGenuineMarkedDiaryCount
    {a : Nat} (A : EnumNode a) : Nat :=
  (allGenuineMarkedDiaryShapes A).length

end ATRFiniteDecoder
end ThreeUniformDiaries
