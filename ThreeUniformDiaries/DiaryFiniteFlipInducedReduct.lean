import ThreeUniformDiaries.DiaryFiniteFlipLeafSupportClosure
import ThreeUniformDiaries.DiaryFiniteSupportInverseRank

/-!
# A finite leaf preembedding induces a genuinely finite diary in a
# countable ambient RoleDiary

The earlier leaf-only closure theorem says that the singleton/full
pair-meet support generated by image leaves is EXACTLY the image
of the bounded source interval [0,n).

The image of a strictly increasing map on n vertices has exactly n
members. Its unique increasing reindexing therefore sends each
source position i < n to its original image f(i). We use the
finite-chain identity for strictly increasing self maps of Fin n
rather than introducing a separate permutation argument.

Consequently, for an ambient countable RoleDiary G, the finite
induced restriction on the full image is a genuine bounded
FiniteRoleDiaryBlock of exactly the same size n. Its complete
edge table is precisely the pullback of G's edges through f.

This establishes the finite-diary structure of the induced
leaf-preembedding pullback. It does NOT yet claim that the
pullback is a FLIP of the source or that f preserves arbitrary
mixed numerical meets in the ambient countable diary.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

variable {A G : Ordered3Graph Nat} {n k : Nat} {f : Nat → Nat}

/-- The leaf-generated support of a finite leaf preembedding
has exactly the source number of vertices. -/
theorem finiteLeafPreembedding_support_card
    (DA : FiniteRoleDiaryBlock A n)
    (P : FiniteLeafPreembedding A G n k f) :
    (finiteLeafMeetSupport G (finiteDiaryLeafImage A n f)).card = n := by
  classical
  rw [finiteLeafPreembedding_leafMeetSupport_eq_image DA P]
  simpa only [Finset.card_range] using
    (Finset.card_image_of_injective (Finset.range n)
      P.strictMono.injective)

/-- The increasing finite reindexing of the generated image
sends source index i exactly to f(i): no dummy vertices or
additional split witnesses are inserted. -/
theorem finiteLeafPreembedding_support_index_eq
    (DA : FiniteRoleDiaryBlock A n)
    (P : FiniteLeafPreembedding A G n k f)
    (i : Nat) (hi : i < n) :
    finiteSupportIndex
      (finiteLeafMeetSupport G (finiteDiaryLeafImage A n f)) i = f i := by
  classical
  let S := finiteLeafMeetSupport G (finiteDiaryLeafImage A n f)
  have hS : S = (Finset.range n).image f :=
    finiteLeafPreembedding_leafMeetSupport_eq_image DA P
  have hCard : S.card = n := finiteLeafPreembedding_support_card DA P
  have hMem (j : Fin n) : f j.val ∈ S := by
    rw [hS]
    exact Finset.mem_image.mpr
      ⟨j.val,Finset.mem_range.mpr j.isLt,rfl⟩
  have hVal (j : Fin n) :
      finiteSupportRank S (f j.val) < n := by
    have h := (finiteSupportRank_spec S (f j.val) (hMem j)).1
    simpa only [hCard] using h
  let rankMap : Fin n → Fin n :=
    fun j => ⟨finiteSupportRank S (f j.val),hVal j⟩
  have hRankMono : StrictMono rankMap := by
    intro a b hab
    have habNat : a.val < b.val := hab
    have hlt := finiteSupportRank_lt S
      (hMem a) (hMem b) (P.strictMono habNat)
    exact hlt
  have hAtI : finiteSupportRank S (f i) = i := by
    have hId : rankMap ⟨i,hi⟩ = ⟨i,hi⟩ :=
      hRankMono.apply_eq
    simpa only [rankMap] using congrArg Fin.val hId
  have hSpec : finiteSupportIndex S (finiteSupportRank S (f i)) = f i :=
    (finiteSupportRank_spec S (f i) (hMem ⟨i,hi⟩)).2
  rw [hAtI] at hSpec
  exact hSpec

/-- A compressed edge of the finite support equals the literal
ambient target edge on the corresponding original images.
The equivalence includes nonedges. -/
theorem finiteLeafPreembedding_support_edge_iff
    (DA : FiniteRoleDiaryBlock A n)
    (P : FiniteLeafPreembedding A G n k f)
    (a b c : Nat) (hab : a < b) (hbc : b < c) (hc : c < n) :
    (finiteSupportGraph G
      (finiteLeafMeetSupport G (finiteDiaryLeafImage A n f))).edge a b c ↔
      G.edge (f a) (f b) (f c) := by
  let S := finiteLeafMeetSupport G (finiteDiaryLeafImage A n f)
  have ha : a < n := by omega
  have hb : b < n := by omega
  have hCard : S.card = n := finiteLeafPreembedding_support_card DA P
  have hMain :=
    finiteSupportGraph_edge_iff G S a b c hab hbc
      (by simpa only [hCard] using hc)
  simpa only [
    finiteLeafPreembedding_support_index_eq DA P a ha,
    finiteLeafPreembedding_support_index_eq DA P b hb,
    finiteLeafPreembedding_support_index_eq DA P c hc
  ] using hMain

/-- The induced target-flip pullback on the exact finite image
is again a genuine finite diary, provided the ambient target is
a complete countable RoleDiary. -/
theorem finiteLeafPreembedding_support_is_finiteDiary
    (DA : FiniteRoleDiaryBlock A n)
    (DG : RoleDiary G)
    (P : FiniteLeafPreembedding A G n k f) :
    FiniteRoleDiaryBlock
      (finiteSupportGraph G
        (finiteLeafMeetSupport G (finiteDiaryLeafImage A n f))) n := by
  let L := finiteDiaryLeafImage A n f
  have hLeaves : ∀ v : Nat, v ∈ L → IsLeaf G v := by
    intro v hv
    obtain ⟨u,hu3,hun,huLeaf,hEq⟩ :=
      finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hv
    rw [← hEq]
    exact ((P.role_iff u hu3 hun).1).mpr huLeaf
  have hFull := finiteLeafMeetSupport_is_finiteDiary DG hLeaves
  have hCard := finiteLeafPreembedding_support_card DA P
  simpa only [hCard] using hFull

end DiaryLeafPriority
end ThreeUniformDiaries
