import ThreeUniformDiaries.DiaryFiniteCanonicalCausalCountableFlipOrbit
import ThreeUniformDiaries.DiaryFiniteProtectedFactorization
import ThreeUniformDiaries.DiaryFiniteBoundedUniversality

/-!
# A concrete finite full diary from the canonical sign-rooted source orbit

The verified causal sign-rooted finite pre-diary embeds every
canonical genuine source flip, and its one-pass countable
completion retains all source roles, edges, nonedges and numerical
meets. The finite leaf-meet support construction extracts a
GENUINE finite full diary from any finite family of selected
countable-diary leaves.

Here the finite leaf set is NOT supplied existentially: it is the
explicit union of the images of ALL genuine source leaves across
the actual canonical source-flip orbit. The generated finite
support retains all source split images by their genuine source
V1/V2 witnesses. Sorted support reindexing thus produces one
concrete finite diary, with bounded exact-meet embeddings of
every canonical source flip and a direct rank-recovery formula.

This finishes the finite TARGET construction for the actual
sign-rooted geometry. It does NOT establish injectivity of its
canonical feedback under nontrivial flips of that target.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- The exact finite set of original source-leaf images in the
one-pass completion, across every REAL canonical source flip. -/
noncomputable def canonicalCausalOrbitFiniteLeaves
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) (bits : Nat → Bool) :
    Finset Nat := by
  classical
  exact
    (((Finset.univ : Finset (FiniteCanonicalFlipIndex A n)).product
        (Finset.Ico 3 n)).filter
        (fun p => IsLeaf ((finiteCanonicalSignRootedFamily DA).graph p.1) p.2)).image
      (fun p => canonicalCausalCountableSourceMap DA bits p.1 p.2)

/-- Every genuine source leaf of every canonical branch is
literally one of the globally selected target leaves. -/
theorem canonicalCausalOrbitFiniteLeaves_mem
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) (bits : Nat → Bool)
    (i : FiniteCanonicalFlipIndex A n)
    (u : Nat) (hu3 : 3 ≤ u) (hun : u < n)
    (hu : IsLeaf ((finiteCanonicalSignRootedFamily DA).graph i) u) :
    canonicalCausalCountableSourceMap DA bits i u ∈
      canonicalCausalOrbitFiniteLeaves DA bits := by
  classical
  unfold canonicalCausalOrbitFiniteLeaves
  apply Finset.mem_image.mpr
  refine ⟨(i,u),?_,rfl⟩
  apply Finset.mem_filter.mpr
  exact ⟨Finset.mem_product.mpr
    ⟨Finset.mem_univ _,Finset.mem_Ico.mpr ⟨hu3,hun⟩⟩,hu⟩

/-- The selected vertices are actual LEAVES of the ONE common
countable RoleDiary, using the concrete source flip embeddings. -/
theorem canonicalCausalOrbitFiniteLeaves_areLeaves
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) (bits : Nat → Bool)
    (hEmb : ∀ i : FiniteCanonicalFlipIndex A n,
      FiniteMeetEmbedding
        ((finiteCanonicalSignRootedFamily DA).graph i)
        (onePassRawTarget (canonicalCausalCountableCarrier DA bits))
        n (canonicalCausalCountableSourceMap DA bits i)) :
    ∀ u : Nat, u ∈ canonicalCausalOrbitFiniteLeaves DA bits →
      IsLeaf (onePassRawTarget (canonicalCausalCountableCarrier DA bits)) u := by
  classical
  intro u hu
  unfold canonicalCausalOrbitFiniteLeaves at hu
  obtain ⟨⟨i,z⟩,hp,rfl⟩ := Finset.mem_image.mp hu
  obtain ⟨hProd,hLeaf⟩ := Finset.mem_filter.mp hp
  obtain ⟨_,hz⟩ := Finset.mem_product.mp hProd
  have hzBound := Finset.mem_Ico.mp hz
  exact ((hEmb i).leaf_iff z hzBound.1 hzBound.2).mpr hLeaf

/-- Support generated by all canonical source leaves and their
genuine singleton and full ordered-pair meets. -/
noncomputable def canonicalCausalOrbitFiniteSupport
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) (bits : Nat → Bool) : Finset Nat :=
  finiteLeafMeetSupport
    (onePassRawTarget (canonicalCausalCountableCarrier DA bits))
    (canonicalCausalOrbitFiniteLeaves DA bits)

/-- The concrete finite induced, sorted and reindexed full target. -/
noncomputable def canonicalCausalOrbitFiniteTarget
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) (bits : Nat → Bool) :
    Ordered3Graph Nat :=
  finiteSupportGraph
    (onePassRawTarget (canonicalCausalCountableCarrier DA bits))
    (canonicalCausalOrbitFiniteSupport DA bits)

/-- Explicit finite source map: compose causal source rank,
one-pass old vertex embedding, and the exact support inverse rank. -/
noncomputable def canonicalCausalOrbitFiniteSourceMap
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) (bits : Nat → Bool)
    (i : FiniteCanonicalFlipIndex A n) : Nat → Nat :=
  finiteSupportLift (canonicalCausalOrbitFiniteSupport DA bits)
    n (canonicalCausalCountableSourceMap DA bits i)

/-- One actual finite FULL diary, canonically obtained by compressing
the common sign-rooted countable diary, contains every true
canonical source flip as a bounded full numerical-meet embedding.

The target and all source maps are explicit terms depending only on
the one chosen dummy-tail bit function. This does NOT assert that
every flip of the target contains the UNFLIPPED source diary. -/
theorem exists_canonicalCausalOrbit_finiteFullDiary
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) :
    ∃ bits : Nat → Bool,
      FiniteRoleDiaryBlock
        (canonicalCausalOrbitFiniteTarget DA bits)
        (canonicalCausalOrbitFiniteSupport DA bits).card ∧
      ∀ i : FiniteCanonicalFlipIndex A n,
        FiniteBoundedMeetEmbedding
          ((finiteCanonicalSignRootedFamily DA).graph i)
          (canonicalCausalOrbitFiniteTarget DA bits)
          n (canonicalCausalOrbitFiniteSupport DA bits).card
          (canonicalCausalOrbitFiniteSourceMap DA bits i) := by
  classical
  obtain ⟨bits,hDiary,hEmb⟩ :=
    exists_countableDiary_simultaneousCanonicalSourceFlips_fullEmbedding DA
  let G := onePassRawTarget (canonicalCausalCountableCarrier DA bits)
  let L := canonicalCausalOrbitFiniteLeaves DA bits
  let S := finiteLeafMeetSupport G L
  have hLeaves : ∀ u : Nat, u ∈ L → IsLeaf G u :=
    canonicalCausalOrbitFiniteLeaves_areLeaves DA bits hEmb
  have hFull : FiniteRoleDiaryBlock (finiteSupportGraph G S) S.card :=
    finiteLeafMeetSupport_is_finiteDiary hDiary hLeaves
  refine ⟨bits,hFull,?_⟩
  intro i
  let F := finiteCanonicalSignRootedFamily DA
  let f := canonicalCausalCountableSourceMap DA bits i
  have E : FiniteMeetEmbedding (F.graph i) G n f := hEmb i
  have hSelected : ∀ u : Nat, 3 ≤ u → u < n →
      IsLeaf (F.graph i) u → f u ∈ L := by
    intro u hu3 hun hu
    exact canonicalCausalOrbitFiniteLeaves_mem DA bits i u hu3 hun hu
  have hRange : ∀ u : Nat, u < n → f u ∈ S :=
    E.range_subset_leafMeetSupport (F.flip i).target_diary L hSelected
  have hFinite : FiniteMeetEmbedding
      (F.graph i) (finiteSupportGraph G S) n
      (finiteSupportLift S n f) :=
    E.through_finiteSupport (F.flip i).target_diary S hRange
  have hBound : ∀ u : Nat, u < n →
      finiteSupportLift S n f u < S.card := by
    intro u hu
    exact (finiteSupportLift_spec S n f hRange u hu).1
  exact ⟨hFinite,hBound⟩

end DiaryLeafPriority
end ThreeUniformDiaries
