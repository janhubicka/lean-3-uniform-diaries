import ThreeUniformDiaries.DiaryFiniteCanonicalStrongAbsorption
import ThreeUniformDiaries.DiaryFiniteFlipInducedPullback
import ThreeUniformDiaries.DiaryFiniteLeafPreembeddingComposition
import ThreeUniformDiaries.DiaryFinitePullbackProtectedEmbedding

/-!
# Finite flip absorption pulled back from a countable diary preembedding

A finite full diary B may have only a leaf preembedding into a
countable full diary G. Its image is generated by the image leaves
and their exact singleton/full pair meets. The induced finite
reduct on this support is a genuine finite FLIP of B, already
proved by finiteLeafPreembedding_support_is_flip.

The strong finite second flip property yields a bounded full
meet embedding of a prescribed finite diary A into that induced
flip. Composing with the ORIGINAL leaf preembedding into G
gives a genuine finite leaf preembedding A -> G, with all source
leaf images inside the image of B's leaf set and with the
COMPLETE induced source triple/nontriple table.

The composition only asserts exact numerical meets of genuine
LEAVES, NOT all mixed split-containing meets in the countable
ambient diary. That stronger global transport is a separate
proof obligation if demanded by the final unavoidability API.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

/-- The reverse heterogeneous composition direction: a full
bounded finite meet embedding A -> B followed by a genuine
finite leaf preembedding B -> G produces a finite leaf
preembedding A -> G. This order differs from the earlier
leaf-preembedding-then-full-meet-composition theorem. -/
theorem FiniteBoundedMeetEmbedding.comp_leafPreembedding
    {A B G : Ordered3Graph Nat}
    {n k m : Nat} {e f : Nat → Nat}
    (E : FiniteBoundedMeetEmbedding A B n k e)
    (P : FiniteLeafPreembedding B G k m f) :
    FiniteLeafPreembedding A G n m (fun u => f (e u)) := by
  let M := E.toMeetEmbedding
  refine {
    strictMono := ?_
    marker_zero := ?_
    marker_one := ?_
    marker_two := ?_
    image_bound := ?_
    role_iff := ?_
    leaf_edge_iff := ?_
    leaf_oneMeet := ?_
    leaf_twoMeet := ?_
  }
  · intro a b hab
    exact P.strictMono (M.strictMono hab)
  · change f (e 0) = 0
    rw [M.marker_zero,P.marker_zero]
  · change f (e 1) = 1
    rw [M.marker_one,P.marker_one]
  · change f (e 2) = 2
    rw [M.marker_two,P.marker_two]
  · intro u hun
    exact P.image_bound (e u) (E.image_bound u hun)
  · intro u hu3 hun
    have hE3 : 3 ≤ e u := M.nonmarker_image_ge_three u hu3
    have hEK : e u < k := E.image_bound u hun
    have hSource := M.leaf_iff u hu3 hun
    have hOne := M.oneSplit_iff u hu3 hun
    have hTwo := M.twoSplit_iff u hu3 hun
    obtain ⟨hTargetLeaf,hTargetOne,hTargetTwo⟩ :=
      P.role_iff (e u) hE3 hEK
    exact ⟨hTargetLeaf.trans hSource,
      hTargetOne.trans hOne,hTargetTwo.trans hTwo⟩
  · intro a b c hab hbc hcn ha hb hc
    have han : a < n := by omega
    have hbn : b < n := by omega
    have hBLeafA : IsLeaf B (e a) :=
      (M.leaf_iff a ha.1 han).mpr ha
    have hBLeafB : IsLeaf B (e b) :=
      (M.leaf_iff b hb.1 hbn).mpr hb
    have hBLeafC : IsLeaf B (e c) :=
      (M.leaf_iff c hc.1 hcn).mpr hc
    exact (P.leaf_edge_iff (e a) (e b) (e c)
      (M.strictMono hab) (M.strictMono hbc)
      (E.image_bound c hcn)
      hBLeafA hBLeafB hBLeafC).trans
      (M.edge_iff a b c hab hbc hcn)
  · intro a b ha3 han hb3 hbn ha hb
    have hBLeafA : IsLeaf B (e a) :=
      (M.leaf_iff a ha3 han).mpr ha
    have hBLeafB : IsLeaf B (e b) :=
      (M.leaf_iff b hb3 hbn).mpr hb
    calc
      G.oneMeetLevel (f (e a)) (f (e b)) =
          f (B.oneMeetLevel (e a) (e b)) :=
        P.leaf_oneMeet (e a) (e b)
          (M.nonmarker_image_ge_three a ha3)
          (E.image_bound a han)
          (M.nonmarker_image_ge_three b hb3)
          (E.image_bound b hbn)
          hBLeafA hBLeafB
      _ = f (e (A.oneMeetLevel a b)) :=
        congrArg f (M.oneMeet a b ha3 han hb3 hbn)
  · intro a b c d hab hcd ha3 han hb3 hbn hc3 hcn hd3 hdn
      ha hb hc hd
    have hBLeafA : IsLeaf B (e a) :=
      (M.leaf_iff a ha3 han).mpr ha
    have hBLeafB : IsLeaf B (e b) :=
      (M.leaf_iff b hb3 hbn).mpr hb
    have hBLeafC : IsLeaf B (e c) :=
      (M.leaf_iff c hc3 hcn).mpr hc
    have hBLeafD : IsLeaf B (e d) :=
      (M.leaf_iff d hd3 hdn).mpr hd
    calc
      G.twoMeetLevel (f (e a)) (f (e b))
          (f (e c)) (f (e d)) =
          f (B.twoMeetLevel (e a) (e b) (e c) (e d)) :=
        P.leaf_twoMeet (e a) (e b) (e c) (e d)
          (M.strictMono hab) (M.strictMono hcd)
          (M.nonmarker_image_ge_three a ha3) (E.image_bound a han)
          (M.nonmarker_image_ge_three b hb3) (E.image_bound b hbn)
          (M.nonmarker_image_ge_three c hc3) (E.image_bound c hcn)
          (M.nonmarker_image_ge_three d hd3) (E.image_bound d hdn)
          hBLeafA hBLeafB hBLeafC hBLeafD
      _ = f (e (A.twoMeetLevel a b c d)) :=
        congrArg f (M.twoMeet a b c d hab hcd
          ha3 han hb3 hbn hc3 hcn hd3 hdn)

/-- Let a finite absorber B embed as a LEAF preembedding in
a countable full diary G. Its induced finite leaf-meet support
is a genuine flip H of B, and strong second flip absorption
gives the fixed source A inside H. Composition returns:
* a genuine ordered finite leaf preembedding A -> G;
* the entire induced finite edge AND nonedge table;
* every original source leaf image in the B-preembedding
  leaf range.
No global mixed type equality is assumed in this result. -/
theorem exists_induced_finite_source_in_countable_of_absorber_preembedding
    {A B G : Ordered3Graph Nat} {n k m : Nat}
    {f : Nat → Nat}
    (DA : FiniteRoleDiaryBlock A n)
    (DB : FiniteRoleDiaryBlock B k)
    (DG : RoleDiary G)
    (hAbs : AbsorbsEveryTargetFlipInside A B n k)
    (P : FiniteLeafPreembedding B G k m f) :
    ∃ g : Nat → Nat,
      FiniteLeafPreembedding A G n m g ∧
      (∀ a b c : Nat, a < b → b < c → c < n →
        (G.edge (g a) (g b) (g c) ↔ A.edge a b c)) ∧
      (∀ u : Nat, 3 ≤ u → u < n → IsLeaf A u →
        ∃ v : Nat, v < k ∧ IsLeaf B v ∧ g u = f v) := by
  classical
  let S := finiteLeafMeetSupport G (finiteDiaryLeafImage B k f)
  let H := finiteSupportGraph G S
  have FBH : FiniteDiaryFlip B H k :=
    finiteLeafPreembedding_support_is_flip DB DG P
  obtain ⟨e,EE⟩ := hAbs H FBH
  let g : Nat → Nat := fun u => f (e u)
  have PH : FiniteLeafPreembedding H G k m f :=
    P.of_source_flip FBH
  have hComp : FiniteLeafPreembedding A G n m g :=
    EE.comp_leafPreembedding PH
  refine ⟨g,hComp,?_,?_⟩
  · intro a b c hab hbc hcn
    have hbnd : e c < k := EE.image_bound c hcn
    have hLift :
        H.edge (e a) (e b) (e c) ↔
        G.edge (f (e a)) (f (e b)) (f (e c)) :=
      finiteLeafPreembedding_support_edge_iff DB P
        (e a) (e b) (e c)
        (EE.toMeetEmbedding.strictMono hab)
        (EE.toMeetEmbedding.strictMono hbc) hbnd
    exact hLift.symm.trans
      (EE.toMeetEmbedding.edge_iff a b c hab hbc hcn)
  · intro u hu3 hun huLeaf
    have hE3 : 3 ≤ e u :=
      EE.toMeetEmbedding.nonmarker_image_ge_three u hu3
    have hEK : e u < k := EE.image_bound u hun
    have hHLeaf : IsLeaf H (e u) :=
      (EE.toMeetEmbedding.leaf_iff u hu3 hun).mpr huLeaf
    have hBLeaf : IsLeaf B (e u) :=
      ((FBH.role_iff (e u) hE3 hEK).1).mpr hHLeaf
    exact ⟨e u,hEK,hBLeaf,rfl⟩

/-- Unconditional finite consequence of the merged strong flip
property: for ANY prescribed finite diary A one can choose
one finite diary B so that ANY finite leaf preembedding of B
into ANY countable full diary can be converted to an induced
finite leaf preembedding of A, with all leaf images inside B's
original leaf image. No type-stabilisation or generic-embedding
hypothesis is silently added. -/
theorem exists_universal_finite_preembedding_source
    {A : Ordered3Graph Nat} {n : Nat}
    (DA : FiniteRoleDiaryBlock A n) :
    ∃ (B : Ordered3Graph Nat) (k : Nat),
      FiniteRoleDiaryBlock B k ∧
      (∀ {G : Ordered3Graph Nat} {m : Nat}
        {f : Nat → Nat},
        RoleDiary G →
        FiniteLeafPreembedding B G k m f →
        ∃ g : Nat → Nat,
          FiniteLeafPreembedding A G n m g ∧
          (∀ a b c : Nat, a < b → b < c → c < n →
            (G.edge (g a) (g b) (g c) ↔ A.edge a b c)) ∧
          (∀ u : Nat, 3 ≤ u → u < n → IsLeaf A u →
            ∃ v : Nat, v < k ∧ IsLeaf B v ∧ g u = f v)) := by
  obtain ⟨B,k,DB,hAbs⟩ :=
    exists_finiteDiary_universal_flip_absorber DA
  refine ⟨B,k,DB,?_⟩
  intro G m f DG P
  exact exists_induced_finite_source_in_countable_of_absorber_preembedding
    DA DB DG hAbs P

end DiaryLeafPriority
end ThreeUniformDiaries
