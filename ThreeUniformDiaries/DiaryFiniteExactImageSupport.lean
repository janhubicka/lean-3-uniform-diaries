import ThreeUniformDiaries.DiaryFiniteLeafMeetSupport

/-!
# Track C: exact image of the full finite leaf-meet support

The existing finite diary theorem says that the image of every vertex
of a finite full diary lies in the meet support of its image leaves.
The converse is equally important for upper-bound factorisation:
if the map preserves *all* numerical singleton and full pair meets,
then each meet generated by those image leaves is itself the image
of a source vertex.

We first prove this second inclusion without assuming source/target
diary axioms: the bounded exact-meet embedding interface suffices.
For a finite full source diary and ALL its source leaves, combining
both inclusions gives equality of the ACTUAL finite target vertex sets.

This identifies a canonical finite support as a set of vertices.
It does not assert that the inverse of an arbitrary unordered
generic-to-leaf embedding is aux-type-respecting, nor does it classify
the shapes of all finite induced copies in a universal hypergraph.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

variable {H T : Ordered3Graph Nat} {n : Nat} {f : Nat → Nat}

/-- Any singleton/full-pair meet generated by image vertices
in the bounded source nonmarker range is an image of a source
vertex. The three markers are included because they are fixed.
The proof uses exact numerical meets, not merely induced edges. -/
theorem FiniteMeetEmbedding.image_leafMeetSupport_subset
    (E : FiniteMeetEmbedding H T n f)
    (L : Finset Nat)
    (hRange : ∀ u, u ∈ L → 3 ≤ u ∧ u < n)
    (hn : 3 ≤ n) :
    finiteLeafMeetSupport T (L.image f) ⊆
      (Finset.range n).image f := by
  classical
  let M : Finset Nat := L.image f
  have hImage (u : Nat) (hu : u < n) :
      f u ∈ (Finset.range n).image f :=
    Finset.mem_image.mpr ⟨u, Finset.mem_range.mpr hu, rfl⟩
  have hLift (v : Nat) (hv : v ∈ M) :
      ∃ u : Nat, (3 ≤ u ∧ u < n) ∧ f u = v := by
    obtain ⟨u, hu, hfu⟩ := Finset.mem_image.mp hv
    exact ⟨u, hRange u hu, hfu⟩
  intro x hx
  change x ∈ (Finset.range 3 ∪ M) ∪
      (finiteOneMeetSupport T M ∪ finiteTwoMeetSupport T M) at hx
  rcases Finset.mem_union.mp hx with hFront | hMeets
  · rcases Finset.mem_union.mp hFront with hMarker | hLeaf
    · have hx3 : x < 3 := Finset.mem_range.mp hMarker
      rcases (show x = 0 ∨ x = 1 ∨ x = 2 by omega) with
          rfl | rfl | rfl
      · simpa only [E.marker_zero] using hImage 0 (by omega)
      · simpa only [E.marker_one] using hImage 1 (by omega)
      · simpa only [E.marker_two] using hImage 2 (by omega)
    · obtain ⟨u, hu, hfu⟩ := hLift x hLeaf
      rw [← hfu]
      exact hImage u hu.2
  · rcases Finset.mem_union.mp hMeets with hOne | hTwo
    · change x ∈
        ((M.product M).filter (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => T.oneMeetLevel p.1 p.2) at hOne
      obtain ⟨⟨v,w⟩, hp, hEq⟩ := Finset.mem_image.mp hOne
      obtain ⟨hp, _⟩ := Finset.mem_filter.mp hp
      obtain ⟨hv, hw⟩ := Finset.mem_product.mp hp
      obtain ⟨a, ⟨ha3, han⟩, rfl⟩ := hLift v hv
      obtain ⟨b, ⟨hb3, hbn⟩, rfl⟩ := hLift w hw
      have hMeet :=
        E.oneMeet a b ha3 han hb3 hbn
      have hBound : H.oneMeetLevel a b < n := by
        have h := H.oneMeetLevel_le_min a b
        omega
      rw [← hEq, hMeet]
      exact hImage (H.oneMeetLevel a b) hBound
    · change x ∈
        ((finiteOrderedLeafPairs M).product
            (finiteOrderedLeafPairs M)).image
          (fun p : (Nat × Nat) × (Nat × Nat) =>
            T.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hTwo
      obtain ⟨⟨⟨v,w⟩,⟨y,z⟩⟩, hp, hEq⟩ :=
        Finset.mem_image.mp hTwo
      obtain ⟨hpVW, hpYZ⟩ := Finset.mem_product.mp hp
      obtain ⟨hpVW, hvw⟩ := Finset.mem_filter.mp hpVW
      obtain ⟨hpYZ, hyz⟩ := Finset.mem_filter.mp hpYZ
      obtain ⟨hv, hw⟩ := Finset.mem_product.mp hpVW
      obtain ⟨hy, hz⟩ := Finset.mem_product.mp hpYZ
      obtain ⟨a, ⟨ha3, han⟩, rfl⟩ := hLift v hv
      obtain ⟨b, ⟨hb3, hbn⟩, rfl⟩ := hLift w hw
      obtain ⟨c, ⟨hc3, hcn⟩, rfl⟩ := hLift y hy
      obtain ⟨d, ⟨hd3, hdn⟩, rfl⟩ := hLift z hz
      have hab : a < b := by
        by_contra h
        have hba : b ≤ a := by omega
        have hmon := E.strictMono.monotone hba
        omega
      have hcd : c < d := by
        by_contra h
        have hdc : d ≤ c := by omega
        have hmon := E.strictMono.monotone hdc
        omega
      have hMeet := E.twoMeet a b c d hab hcd
        ha3 han hb3 hbn hc3 hcn hd3 hdn
      have hBound : H.twoMeetLevel a b c d < n := by
        have h := H.twoMeetLevel_le_min a b c d
        omega
      rw [← hEq, hMeet]
      exact hImage (H.twoMeetLevel a b c d) hBound

/-- Strong exact finite-support transport:
the finite image of ALL original source diary vertices is exactly
the marker-complete support generated by the images of its leaves.
No auxiliary-type-respectingness is claimed for a pullback into
a third ambient graph. -/
theorem FiniteMeetEmbedding.range_eq_image_leafMeetSupport
    (D : FiniteRoleDiaryBlock H n)
    (E : FiniteMeetEmbedding H T n f)
    (hn : 3 ≤ n) :
    (Finset.range n).image f =
      finiteLeafMeetSupport T
        (((Finset.Ico 3 n).filter (fun u => IsLeaf H u)).image f) := by
  classical
  let L : Finset Nat := (Finset.Ico 3 n).filter (fun u => IsLeaf H u)
  have hRange : ∀ u : Nat, u ∈ L → 3 ≤ u ∧ u < n := by
    intro u hu
    exact Finset.mem_Ico.mp (Finset.mem_filter.mp hu).1
  have hLeaves : ∀ u : Nat, 3 ≤ u → u < n →
      IsLeaf H u → f u ∈ L.image f := by
    intro u hu3 hun hLeaf
    apply Finset.mem_image.mpr
    exact ⟨u, Finset.mem_filter.mpr
      ⟨Finset.mem_Ico.mpr ⟨hu3, hun⟩, hLeaf⟩, rfl⟩
  apply Finset.Subset.antisymm
  · intro x hx
    obtain ⟨u, hu, hfu⟩ := Finset.mem_image.mp hx
    rw [← hfu]
    exact E.range_subset_leafMeetSupport D (L.image f) hLeaves
      u (Finset.mem_range.mp hu)
  · exact E.image_leafMeetSupport_subset L hRange hn

end DiaryLeafPriority
end ThreeUniformDiaries
