import ThreeUniformDiaries.DiaryLeafGeneratedStageCompatibility

/-!
# Adversarial gap obstruction to extending arbitrary finite diary stages

Even though source support S_m is generated by selected leaves, a
new leaf m may introduce a fresh 1-split s earlier than an old selected
leaf a. Its image must be strictly between marker 2 and the prescribed
old leaf image. Hence any later admissible stage containing s<a
necessarily maps a at least to level 4.

In particular, a formally admissible stage whose old leaf is placed
at target level 3 cannot receive a fresh split before it. However
S1 implies that a genuinely full diary with two leaves has NO leaf
at level 3, so this toy bound alone is not a relevant generic-leaf
counterexample. The robust gap test is instead an old pair x<y
with CONSECUTIVE target images and a new source split x<s<y:
no successor preserving the old leaf images can insert s.
No explicit full-diary countable counterexample is asserted.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

variable {H K : Ordered3Graph Nat} {F : Nat → Nat}

/-- Any admissible map whose support contains a nonmarker
split or vertex s strictly before a must reserve at least
one target nonmarker level for s before a. -/
theorem AdmissibleCofinalDiaryStage.old_leaf_gap_of_split_before
    {m : Nat} {g : Nat → Nat}
    (Q : AdmissibleCofinalDiaryStage H K F (m + 1) g)
    (a s : Nat)
    (ha : a ∈ countableDiaryFiniteSupport H (m + 1))
    (hs : s ∈ countableDiaryFiniteSupport H (m + 1))
    (hs3 : 3 ≤ s) (hsa : s < a) :
    4 ≤ g a := by
  have hTwo : 2 ∈ countableDiaryFiniteSupport H (m + 1) :=
    mem_finiteLeafMeetSupport_marker H
      (countableDiaryLeafPrefix H (m + 1)) 2 (by omega)
  have h2s := Q.ordered 2 s hTwo hs (by omega)
  have hsa' := Q.ordered s a hs ha hsa
  rw [Q.marker_two] at h2s
  omega

/-- A legal finite stage placing an old genuine leaf at the
earliest nonmarker target level 3 is a DEAD END as soon as
the successor support is forced to include a nonmarker
source split strictly before that leaf. Exact preservation
of old LEAF images alone is already impossible. -/
theorem AdmissibleCofinalDiaryStage.no_successor_of_new_split_before_leaf_at_three
    {m : Nat} {f : Nat → Nat}
    (P : AdmissibleCofinalDiaryStage H K F m f)
    (a s : Nat)
    (ha : a ∈ countableDiaryLeafPrefix H m)
    (hs : s ∈ countableDiaryFiniteSupport H (m + 1))
    (hs3 : 3 ≤ s) (hsa : s < a)
    (hfa : f a = 3) :
    ¬ ∃ g : Nat → Nat,
      AdmissibleCofinalDiaryStage H K F (m + 1) g ∧
      (∀ u : Nat, u ∈ countableDiaryLeafPrefix H m →
        g u = f u) := by
  rintro ⟨g,Q,hOldLeaf⟩
  have hOldSupported :
      a ∈ countableDiaryFiniteSupport H m :=
    mem_finiteLeafMeetSupport_leaf H
      (countableDiaryLeafPrefix H m) a ha
  have hNewSupported :
      a ∈ countableDiaryFiniteSupport H (m + 1) :=
    (countableDiaryFiniteSupport_mono H m (m + 1) (by omega))
      hOldSupported
  have hGap := Q.old_leaf_gap_of_split_before
    a s hNewSupported hs hs3 hsa
  have hImage : g a = 3 := (hOldLeaf a ha).trans hfa
  omega


/-- The illustrative target level 3 can never be a leaf if a
genuine full diary has a second leaf: their S1 meet would be
a one-split at or below 3, and hence equal 3, contradicting
the role of the first leaf. This prevents over-interpreting
the level-3 gap test as an actual generic-leaf counterexample. -/
theorem RoleDiary.leaf_three_unique
    {K : Ordered3Graph Nat} (DK : RoleDiary K)
    (hLeaf3 : IsLeaf K 3)
    (b : Nat) (hb : IsLeaf K b) : b = 3 := by
  by_contra hNe
  have hDistinct : 3 ≠ b := Ne.symm hNe
  have hOne := DK.singleton_meets 3 b hLeaf3 hb hDistinct
  have hUpper : K.oneMeetLevel 3 b ≤ 3 :=
    (K.oneMeetLevel_le_min 3 b).trans (min_le_left _ _)
  have hEq : K.oneMeetLevel 3 b = 3 := by
    have hLower := hOne.1
    omega
  have hOneAt3 : IsOneSplit K 3 := by
    simpa only [hEq] using hOne
  exact hLeaf3.2.1 hOneAt3.2.1

/-- The more useful relative-fusion obstruction: there is
no target room for a NEW source split s strictly between two
OLD supported vertices x<y when their prescribed target
images are consecutive. Agreeing on old selected leaves
already forces agreement on x and y by the leaf-generation
theorem; therefore the obstruction applies even when a
relative successor only promises to keep old LEAF images. -/
theorem AdmissibleCofinalDiaryStage.no_successor_into_consecutive_old_gap
    {m : Nat} {f : Nat → Nat}
    (P : AdmissibleCofinalDiaryStage H K F m f)
    (x s y : Nat)
    (hx : x ∈ countableDiaryFiniteSupport H m)
    (hy : y ∈ countableDiaryFiniteSupport H m)
    (hs : s ∈ countableDiaryFiniteSupport H (m + 1))
    (hxs : x < s) (hsy : s < y)
    (hConsecutive : f y = f x + 1) :
    ¬ ∃ g : Nat → Nat,
      AdmissibleCofinalDiaryStage H K F (m + 1) g ∧
      (∀ u : Nat, u ∈ countableDiaryLeafPrefix H m →
        g u = f u) := by
  rintro ⟨g,Q,hLeaves⟩
  have hCompat : CofinalDiaryStageCompatible H m f g :=
    P.successor_compatible_of_selected_leaf_agreement Q hLeaves
  have hx' : x ∈ countableDiaryFiniteSupport H (m + 1) :=
    (countableDiaryFiniteSupport_mono H m (m + 1) (by omega)) hx
  have hy' : y ∈ countableDiaryFiniteSupport H (m + 1) :=
    (countableDiaryFiniteSupport_mono H m (m + 1) (by omega)) hy
  have hFirst := Q.ordered x s hx' hs hxs
  have hSecond := Q.ordered s y hs hy' hsy
  have hImageX : g x = f x := hCompat x hx
  have hImageY : g y = f y := hCompat y hy
  omega

end DiaryLeafPriority
end ThreeUniformDiaries
