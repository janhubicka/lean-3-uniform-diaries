import ThreeUniformDiaries.DiaryFiniteFlipTargetTransport
import ThreeUniformDiaries.DiaryFiniteLeafMeetCompleteReduct
import ThreeUniformDiaries.DiaryFiniteLeafMeetSupport
import ThreeUniformDiaries.DiaryChosenLeafOneMeets

/-!
# Leaf-meet support of a genuine finite leaf preembedding

The verified finite leaf-meet extraction theorem can be used to
analyse target flips more precisely than the abstract finite JEP.

Let a bounded genuine finite diary A be mapped by a finite LEAF
preembedding into an arbitrary ambient ordered ternary graph G.
The map is strictly increasing, preserves 0/1/2 and all leaf
singleton/full pair-type numerical meets, but it need not
preserve any split-containing numerical meet.

Then the finite support generated by the image of its leaves
is EXACTLY the full image of its finite vertex interval.

Indeed every source split is generated by a source leaf meet
(V1/V2 bounded witnesses), while each ambient meet of image
leaves is the image of the corresponding source meet.
No mixed-meet preservation, type-reflection, or flip absorption
is used.

This gives a finite-range closure result for the safe leaf-only
pullback after a target flip. It is a necessary ingredient for
identifying the induced target-flip pullback with a genuine finite
diary by the existing extraction theorem.
-/

namespace ThreeUniformDiaries
namespace DiaryLeafPriority

variable {A G : Ordered3Graph Nat} {n k : Nat} {f : Nat → Nat}

/-- The finite set of actual leaf images of a bounded diary. -/
noncomputable def finiteDiaryLeafImage
    (A : Ordered3Graph Nat) (n : Nat) (f : Nat → Nat) : Finset Nat := by
  classical
  exact ((Finset.Ico 3 n).filter (fun u => IsLeaf A u)).image f

theorem finiteDiaryLeafImage_mem
    (u : Nat) (hu3 : 3 ≤ u) (hun : u < n) (hLeaf : IsLeaf A u) :
    f u ∈ finiteDiaryLeafImage A n f := by
  classical
  unfold finiteDiaryLeafImage
  exact Finset.mem_image.mpr ⟨u,
    Finset.mem_filter.mpr
      ⟨Finset.mem_Ico.mpr ⟨hu3,hun⟩,hLeaf⟩,rfl⟩

/-- Every member of the selected leaf image has a genuine
source leaf preimage inside the bounded source frame. -/
theorem finiteDiaryLeafImage_source
    {v : Nat} (hv : v ∈ finiteDiaryLeafImage A n f) :
    ∃ u : Nat, 3 ≤ u ∧ u < n ∧ IsLeaf A u ∧ f u = v := by
  classical
  unfold finiteDiaryLeafImage at hv
  obtain ⟨u,hu,huv⟩ := Finset.mem_image.mp hv
  obtain ⟨huFrame,huLeaf⟩ := Finset.mem_filter.mp hu
  obtain ⟨hu3,hun⟩ := Finset.mem_Ico.mp huFrame
  exact ⟨u,hu3,hun,huLeaf,huv⟩

/-- All selected source vertices, including each split,
are generated from the leaf image by markers and leaf meets.
This does not require mixed-meet transport. -/
theorem finiteLeafPreembedding_image_subset_leafMeetSupport
    (DA : FiniteRoleDiaryBlock A n)
    (P : FiniteLeafPreembedding A G n k f) :
    ∀ u : Nat, u < n →
      f u ∈ finiteLeafMeetSupport G (finiteDiaryLeafImage A n f) := by
  intro u hun
  by_cases hu3 : 3 ≤ u
  · rcases DA.prediary.role_valid u hu3 hun with hLeaf | hOne | hTwo
    · exact mem_finiteLeafMeetSupport_leaf G
        (finiteDiaryLeafImage A n f) (f u)
        (finiteDiaryLeafImage_mem (A := A) (n := n) (f := f)
          u hu3 hun hLeaf)
    · obtain ⟨a,b,han,hbn,ha,hb,hua,hub,hMeet⟩ :=
        DA.prediary.one_split_witness u hOne hun
      have haMem := finiteDiaryLeafImage_mem
        (A := A) (n := n) (f := f) a ha.1 han ha
      have hbMem := finiteDiaryLeafImage_mem
        (A := A) (n := n) (f := f) b hb.1 hbn hb
      have hne : a ≠ b := by
        intro heq
        subst b
        have hSelf := Ordered3Graph.oneMeetLevel_self A a
        omega
      have hImageNe : f a ≠ f b := by
        intro h
        exact hne (P.strictMono.injective h)
      have hImageMeet : G.oneMeetLevel (f a) (f b) = f u := by
        rw [P.leaf_oneMeet a b ha.1 han hb.1 hbn ha hb,hMeet]
      rw [← hImageMeet]
      exact mem_finiteLeafMeetSupport_oneMeet
        G (finiteDiaryLeafImage A n f)
        (f a) (f b) haMem hbMem hImageNe
    · obtain ⟨a,b,c,d,hab,hcd,han,hbn,hcn,hdn,
        ha,hb,hc,hd,hua,huc,hMeet⟩ :=
          DA.prediary.two_split_witness u hTwo hun
      have haMem := finiteDiaryLeafImage_mem
        (A := A) (n := n) (f := f) a ha.1 han ha
      have hbMem := finiteDiaryLeafImage_mem
        (A := A) (n := n) (f := f) b hb.1 hbn hb
      have hcMem := finiteDiaryLeafImage_mem
        (A := A) (n := n) (f := f) c hc.1 hcn hc
      have hdMem := finiteDiaryLeafImage_mem
        (A := A) (n := n) (f := f) d hd.1 hdn hd
      have hImageMeet : G.twoMeetLevel (f a) (f b) (f c) (f d) =
          f u := by
        rw [P.leaf_twoMeet a b c d hab hcd
          ha.1 han hb.1 hbn hc.1 hcn hd.1 hdn
          ha hb hc hd, hMeet]
      rw [← hImageMeet]
      exact mem_finiteLeafMeetSupport_twoMeet
        G (finiteDiaryLeafImage A n f)
        (f a) (f b) (f c) (f d)
        (P.strictMono hab) (P.strictMono hcd)
        haMem hbMem hcMem hdMem
  · have hSmall : u = 0 ∨ u = 1 ∨ u = 2 := by omega
    rcases hSmall with h0 | h1 | h2
    · subst u
      rw [P.marker_zero]
      exact mem_finiteLeafMeetSupport_marker G
        (finiteDiaryLeafImage A n f) 0 (by omega)
    · subst u
      rw [P.marker_one]
      exact mem_finiteLeafMeetSupport_marker G
        (finiteDiaryLeafImage A n f) 1 (by omega)
    · subst u
      rw [P.marker_two]
      exact mem_finiteLeafMeetSupport_marker G
        (finiteDiaryLeafImage A n f) 2 (by omega)

/-- The reverse inclusion uses only leaf-meet preservation:
all new generator meets are themselves images of bounded
source vertices. Strict order is reflected by injectivity. -/
theorem finiteLeafPreembedding_leafMeetSupport_subset_image
    (P : FiniteLeafPreembedding A G n k f)
    (hn3 : 3 ≤ n) :
    ∀ v : Nat,
      v ∈ finiteLeafMeetSupport G (finiteDiaryLeafImage A n f) →
      v ∈ (Finset.range n).image f := by
  classical
  intro v hv
  let L := finiteDiaryLeafImage A n f
  change v ∈ (Finset.range 3 ∪ L) ∪
    (finiteOneMeetSupport G L ∪ finiteTwoMeetSupport G L) at hv
  rcases Finset.mem_union.mp hv with hFront | hMeets
  · rcases Finset.mem_union.mp hFront with hMarker | hLeaf
    · have hSmall : v < 3 := Finset.mem_range.mp hMarker
      have hIndex : v < n := by omega
      have hFix : f v = v := by
        interval_cases v
        · exact P.marker_zero
        · exact P.marker_one
        · exact P.marker_two
      exact Finset.mem_image.mpr
        ⟨v,Finset.mem_range.mpr hIndex,hFix⟩
    · obtain ⟨u,hu3,hun,hRole,hfu⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hLeaf
      exact Finset.mem_image.mpr
        ⟨u,Finset.mem_range.mpr hun,hfu⟩
  · rcases Finset.mem_union.mp hMeets with hOne | hTwo
    · change v ∈ ((L.product L).filter
        (fun p : Nat × Nat => p.1 ≠ p.2)).image
          (fun p : Nat × Nat => G.oneMeetLevel p.1 p.2) at hOne
      obtain ⟨p,hp,hpv⟩ := Finset.mem_image.mp hOne
      rcases p with ⟨x,y⟩
      change G.oneMeetLevel x y = v at hpv
      obtain ⟨hxy,_hne⟩ := Finset.mem_filter.mp hp
      obtain ⟨hx,hy⟩ := Finset.mem_product.mp hxy
      obtain ⟨a,ha3,han,haLeaf,haEq⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hx
      obtain ⟨b,hb3,hbn,hbLeaf,hbEq⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hy
      have hOldMeet := P.leaf_oneMeet a b ha3 han hb3 hbn haLeaf hbLeaf
      have hBound := A.oneMeetLevel_le_min a b
      have hmn : A.oneMeetLevel a b < n := by omega
      have hValue : f (A.oneMeetLevel a b) = v := by
        calc
          f (A.oneMeetLevel a b) = G.oneMeetLevel (f a) (f b) :=
            hOldMeet.symm
          _ = G.oneMeetLevel x y := by rw [haEq,hbEq]
          _ = v := hpv
      exact Finset.mem_image.mpr
        ⟨A.oneMeetLevel a b,Finset.mem_range.mpr hmn,hValue⟩
    · change v ∈
        ((finiteOrderedLeafPairs L).product
          (finiteOrderedLeafPairs L)).image
          (fun p : (Nat × Nat) × (Nat × Nat) =>
            G.twoMeetLevel p.1.1 p.1.2 p.2.1 p.2.2) at hTwo
      obtain ⟨p,hp,hpv⟩ := Finset.mem_image.mp hTwo
      rcases p with ⟨⟨x,y⟩,⟨z,w⟩⟩
      change G.twoMeetLevel x y z w = v at hpv
      obtain ⟨hxyP,hzwP⟩ := Finset.mem_product.mp hp
      obtain ⟨hxyMem,hxy⟩ := Finset.mem_filter.mp hxyP
      obtain ⟨hzwMem,hzw⟩ := Finset.mem_filter.mp hzwP
      obtain ⟨hx,hy⟩ := Finset.mem_product.mp hxyMem
      obtain ⟨hz,hw⟩ := Finset.mem_product.mp hzwMem
      obtain ⟨a,ha3,han,haLeaf,haEq⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hx
      obtain ⟨b,hb3,hbn,hbLeaf,hbEq⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hy
      obtain ⟨c,hc3,hcn,hcLeaf,hcEq⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hz
      obtain ⟨d,hd3,hdn,hdLeaf,hdEq⟩ :=
        finiteDiaryLeafImage_source (A := A) (n := n) (f := f) hw
      have hab : a < b := by
        by_contra hnot
        have hba : b ≤ a := Nat.le_of_not_gt hnot
        have hge := P.strictMono.monotone hba
        rw [haEq,hbEq] at hge
        omega
      have hcd : c < d := by
        by_contra hnot
        have hdc : d ≤ c := Nat.le_of_not_gt hnot
        have hge := P.strictMono.monotone hdc
        rw [hcEq,hdEq] at hge
        omega
      have hOldMeet := P.leaf_twoMeet a b c d hab hcd
        ha3 han hb3 hbn hc3 hcn hd3 hdn
        haLeaf hbLeaf hcLeaf hdLeaf
      have hBound := A.twoMeetLevel_le_min a b c d
      have hmn : A.twoMeetLevel a b c d < n := by omega
      have hValue : f (A.twoMeetLevel a b c d) = v := by
        calc
          f (A.twoMeetLevel a b c d) =
              G.twoMeetLevel (f a) (f b) (f c) (f d) := hOldMeet.symm
          _ = G.twoMeetLevel x y z w := by rw [haEq,hbEq,hcEq,hdEq]
          _ = v := hpv
      exact Finset.mem_image.mpr
        ⟨A.twoMeetLevel a b c d, Finset.mem_range.mpr hmn,hValue⟩

/-- EXACT IMAGE CLOSURE: a leaf-meet-preserving finite
preembedding has no extra vertices when one extracts the
finite support generated by its actual leaf images. -/
theorem finiteLeafPreembedding_leafMeetSupport_eq_image
    (DA : FiniteRoleDiaryBlock A n)
    (P : FiniteLeafPreembedding A G n k f) :
    finiteLeafMeetSupport G (finiteDiaryLeafImage A n f) =
      (Finset.range n).image f := by
  classical
  apply Finset.Subset.antisymm
  · intro v hv
    exact finiteLeafPreembedding_leafMeetSupport_subset_image
      P DA.prediary.frame.length_ge_three v hv
  · intro v hv
    obtain ⟨u,hu,huv⟩ := Finset.mem_image.mp hv
    subst v
    exact finiteLeafPreembedding_image_subset_leafMeetSupport
      DA P u (Finset.mem_range.mp hu)

end DiaryLeafPriority
end ThreeUniformDiaries
